{
  "name": "welding-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "dev:mobile": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "prisma generate && next build",
    "build:electron": "mv src/app/api src/app/_api && ELECTRON_BUILD=true prisma generate && ELECTRON_BUILD=true next build && mv src/app/_api src/app/api",
    "start": "tsx scripts/bootstrap.ts && NODE_OPTIONS='--max-old-space-size=448' next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:prod:report": "npm audit --omit=dev --audit-level=high || echo \"Production audit found advisories; deploy continues. Review audit output and upgrade dependencies separately.\"",
    "verify": "npm run lint && npm run test:smoke && npm run test:offline-gate && npm run build",
    "test:offline-gate": "node scripts/offline-feature-gate.cjs",
    "test:e2e": "playwright test",
    "test:smoke": "node --import tsx --test scripts/security-headers.test.cjs src/lib/deployment-profile.test.ts src/lib/opening-calculations.test.ts src/app/api/health.test.ts src/app/api/ping.test.ts src/app/api/v1/auth/me.test.ts src/lib/auth.test.ts src/lib/session.test.ts src/lib/middleware.test.ts src/lib/rate-limit.test.ts src/lib/security-audit-regression.test.ts src/lib/security-audit-v2-regression.test.ts src/lib/accounting-race.test.ts src/lib/schema-integrity.test.ts src/lib/offline-form-cache-hydrate.test.ts src/lib/offline-cache.test.ts src/lib/offline-aggregate-prefetch.test.ts src/lib/offline-full-sync-read.test.ts src/lib/offline-remaining-mutations.test.ts src/lib/offline-local-search.test.ts src/lib/offline-phase3.test.ts src/lib/sanitize-validation-details.test.ts src/lib/secret-exposure-guard.test.ts",
    "test:critical-db": "node --import tsx --test src/app/api/v1/sync-idempotency-customers.test.ts src/app/api/v1/sync-idempotency-withdrawals.test.ts src/app/api/v1/sync-idempotency-openings.test.ts src/app/api/v1/sync-idempotency-suppliers.test.ts src/app/api/v1/sync-idempotency-intermediaries.test.ts src/app/api/v1/sync-idempotency-intermediary-deposits.test.ts src/app/api/v1/sync-idempotency-intermediary-exchanges.test.ts src/app/api/v1/sync-idempotency-products.test.ts src/app/api/v1/sync-idempotency-shipping-lines.test.ts src/app/api/v1/sync-idempotency-agents.test.ts src/app/api/v1/sync-idempotency-bank-accounts.test.ts src/app/api/v1/sync-idempotency-supplier-payments.test.ts src/app/api/v1/sync-idempotency-shipping-line-payments.test.ts src/app/api/v1/sync-idempotency-super-admin-expenses.test.ts src/app/api/v1/sync-idempotency-agent-payments.test.ts src/app/api/v1/sync-idempotency-lot-costs.test.ts src/app/api/v1/payments-completed-lot.test.ts src/app/api/v1/bank-deposits-transfer-type.test.ts src/app/api/v1/personal-withdrawal-names.test.ts src/app/api/v1/search-amount-column.test.ts src/app/api/v1/search-city-finance-modules.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:migrate:deploy": "tsx scripts/migrate-deploy.ts",
    "setup:offline": "bash scripts/setup-offline.sh",
    "setup": "bash setup.sh",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "db:purge-legacy-stock": "tsx scripts/purge-legacy-stock.ts",
    "package:android:init": "npx cap add android",
    "package:android:sync": "npx cap sync android",
    "package:android:open": "npx cap open android",
    "package:mac:dev": "electron electron/main.cjs",
    "package:mac:dist": "npm run build:electron && electron-builder --mac dmg --publish never",
    "offline-seed:generate": "tsx scripts/generate-offline-seed.ts",
    "offline-seed:generate:lahore": "tsx scripts/generate-offline-seed.ts -- --city=Lahore",
    "package:mac:dist:lahore": "npm run offline-seed:generate:lahore && npm run build:electron && electron-builder --mac dmg --publish never -c.productName=\"MRF Hardware - Lahore\" -c.mac.artifactName='MRF-Hardware-Lahore-${version}.${ext}'",
    "rls:status": "node --import tsx scripts/rls-admin.ts --status",
    "rls:enable": "node --import tsx scripts/rls-admin.ts --enable",
    "rls:disable": "node --import tsx scripts/rls-admin.ts --disable"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@prisma/client": "^5.15.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.400.0",
    "next": "^14.2.35",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.12.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@playwright/test": "^1.58.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.19.37",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.38",
    "prisma": "^5.15.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.mrf.hardware",
    "productName": "MRF Hardware",
    "directories": {
      "output": "release/mac"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    }
  }
}
