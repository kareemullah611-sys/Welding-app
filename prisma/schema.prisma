// ============================================================
// LOTS
// ============================================================

model Lot {
  id                      Int               @id @default(autoincrement())
  countryId               Int               @map("country_id")
  consigneeId             Int?              @map("consignee_id")
  destinationCityId       Int?              @map("destination_city_id")
  lotNumber               String            @map("lot_number") @db.VarChar(50)
  lotDate                 DateTime          @map("lot_date") @db.Date
  notes                   String?           @db.Text
  pkrExchangeRate         Decimal?          @map("pkr_exchange_rate") @db.Decimal(12, 4) // USD/PKR rate for profit calc
  pkrExchangeRateMetadata Json?             @map("pkr_exchange_rate_metadata")
  status                  LotStatus         @default(ongoing)
  shipmentStatus          LotShipmentStatus @default(order_confirmed) @map("shipment_status")
  etaDate                 DateTime?         @map("eta_date") @db.Date
  isLegacyStock           Boolean           @default(false) @map("is_legacy_stock")
  createdBy               Int               @map("created_by")
  completedBy             Int?              @map("completed_by")
  completedAt             DateTime?         @map("completed_at")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  country                          Country                           @relation(fields: [countryId], references: [id])
  consignee                        Consignee?                        @relation(fields: [consigneeId], references: [id], onDelete: SetNull)
  destinationCity                  City?                             @relation("LotDestinationCity", fields: [destinationCityId], references: [id], onDelete: SetNull)
  creator                          User                              @relation("LotCreatedBy", fields: [createdBy], references: [id])
  completer                        User?                             @relation("LotCompletedBy", fields: [completedBy], references: [id])
  documents                        LotDocument[]
  shipmentHistory                  LotStatusHistory[]
  lotProducts                      LotProduct[]
  lotCityDistributions             LotCityDistribution[]
  sales                            Sale[]
  payments                         Payment[]
  expenses                         Expense[]
  hajiTransfers                    HajiTransfer[]
  godownTransfers                  GodownTransfer[]
  saleDiscounts                    SaleDiscount[]
  paymentLotTransfersFrom          PaymentLotTransfer[]              @relation("TransferFromLot")
  paymentLotTransfersTo            PaymentLotTransfer[]              @relation("TransferToLot")
  lotSettlementOverflowsFrom       LotSettlementOverflow[]           @relation("OverflowFromLot")
  lotSettlementOverflowsTo         LotSettlementOverflow[]           @relation("OverflowToLot")
  lotSettlementUnresolvedOverflows LotSettlementUnresolvedOverflow[] @relation("UnresolvedOverflowLot")
  lotPurchases                     LotPurchase[]
  lotCosts                         LotCost[]
  supplierPayments                 SupplierPayment[]
  shippingLinePayments             ShippingLinePayment[]
  cityTransfers                    CityTransfer[]
  cityLiabilityEntries             CityLiabilityEntry[]
  saleItems                        SaleItem[]
  openingInventoryValuations       OpeningInventoryValuation[]

  @@unique([countryId, lotNumber])
  @@index([countryId])
  @@index([consigneeId])
  @@index([destinationCityId])
  @@index([shipmentStatus])
  @@index([status])
  @@index([lotDate])
  @@map("lots")
}

model Consignee {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(200)
  countryId Int?     @map("country_id")
  cityId    Int?     @map("city_id")
  phone     String?  @db.VarChar(100)
  address   String?  @db.Text
  notes     String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  country Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city    City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  creator User?    @relation("ConsigneeCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  lots    Lot[]

  @@index([countryId])
  @@index([cityId])
  @@index([isActive])
  @@map("consignees")
}

model LotDocument {
  id               Int                 @id @default(autoincrement())
  lotId            Int                 @map("lot_id")
  category         LotDocumentCategory @default(other)
  originalFileName String              @map("original_file_name") @db.VarChar(500)
  storageKey       String              @map("storage_key") @db.VarChar(1000)
  fileUrl          String              @map("file_url") @db.VarChar(1000)
  mimeType         String              @map("mime_type") @db.VarChar(200)
  extension        String              @db.VarChar(20)
  fileSize         Int                 @map("file_size")
  referenceNo      String?             @map("reference_no") @db.VarChar(100)
  documentDate     DateTime?           @map("document_date") @db.Date
  note             String?             @db.Text
  uploadedBy       Int                 @map("uploaded_by")
  uploadedAt       DateTime            @default(now()) @map("uploaded_at")
  archivedAt       DateTime?           @map("archived_at")
  archivedBy       Int?                @map("archived_by")

  lot      Lot   @relation(fields: [lotId], references: [id], onDelete: Restrict)
  uploader User  @relation("LotDocumentUploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict)
  archiver User? @relation("LotDocumentArchivedBy", fields: [archivedBy], references: [id], onDelete: SetNull)

  @@index([lotId, archivedAt])
  @@index([category])
  @@index([uploadedAt])
  @@map("lot_documents")
}

model LotStatusHistory {
  id             Int                @id @default(autoincrement())
