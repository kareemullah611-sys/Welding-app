// ============================================================
// CORE TABLES
// ============================================================

model Country {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")

  cities                City[]
  lots                  Lot[]
  consignees            Consignee[]
  fallbackExchangeRates CountryFallbackExchangeRate[]

  @@map("countries")
}

model Currency {
  id     Int    @id @default(autoincrement())
  code   String @unique @db.VarChar(10)
  name   String @db.VarChar(100)
  symbol String @db.VarChar(10)

  cityCurrencies                          CityCurrency[]
  sales                                   Sale[]
  payments                                Payment[]
  expenses                                Expense[]
  personalWithdrawals                     PersonalWithdrawal[]
  hajiTransfers                           HajiTransfer[]
  saleDiscounts                           SaleDiscount[]
  lotSettlementOverflows                  LotSettlementOverflow[]
  lotSettlementUnresolvedOverflows        LotSettlementUnresolvedOverflow[]
  bankDeposits                            BankDeposit[]
  investorAccounts                        InvestorAccount[]
  intermediaryDeposits                    IntermediaryDeposit[]
  intermediaryExchangeFrom                IntermediaryExchange[]                   @relation("IntermediaryExchangeFromCurrency")
  intermediaryExchangeTo                  IntermediaryExchange[]                   @relation("IntermediaryExchangeToCurrency")
  intermediaryExchangeBase                IntermediaryExchange[]                   @relation("IntermediaryExchangeBaseCurrency")
  intermediaryExchangeQuote               IntermediaryExchange[]                   @relation("IntermediaryExchangeQuoteCurrency")
  superAdminBankAccounts                  SuperAdminBankAccount[]
  openingCashes                           OpeningCash[]
  openingCustomerBalances                 OpeningCustomerBalance[]
  openingLiabilities                      OpeningLiability[]
  cityLiabilityEntries                    CityLiabilityEntry[]
  openingCityLiabilities                  OpeningCityLiability[]
  openingBankBalances                     OpeningBankBalance[]
  openingCheques                          OpeningCheque[]
  openingHajiBalances                     OpeningHajiBalance[]
  openingSuperAdminAccountBalances        OpeningSuperAdminAccountBalance[]
  openingInventoryValuations              OpeningInventoryValuation[]
  hajiCashReceipts                        HajiCashReceipt[]
  countryFallbackFromRates                CountryFallbackExchangeRate[]            @relation("CountryFallbackFromCurrency")
  countryFallbackToRates                  CountryFallbackExchangeRate[]            @relation("CountryFallbackToCurrency")
  intermediaryUsdCostLayers               IntermediaryUsdCostLayer[]
  exchangeRateFromRecords                 ExchangeRate[]                           @relation("ExchangeRateFromCurrency")
  exchangeRateToRecords                   ExchangeRate[]                           @relation("ExchangeRateToCurrency")
  sarafiAfSnapshotQuoteBaseRecords        SarafiAfFxSnapshotQuote[]                @relation("SarafiAfSnapshotQuoteBaseCurrency")
  sarafiAfSnapshotQuoteQuoteRecords       SarafiAfFxSnapshotQuote[]                @relation("SarafiAfSnapshotQuoteQuoteCurrency")
  sarafiAfDerivedFromRecords              SarafiAfFxDerivedRate[]                  @relation("SarafiAfDerivedFromCurrency")
  sarafiAfDerivedToRecords                SarafiAfFxDerivedRate[]                  @relation("SarafiAfDerivedToCurrency")
  investmentParticipantSettlements        InvestmentParticipantSettlement[]
  investmentParticipantSettlementPayments InvestmentParticipantSettlementPayment[]
  superAdminLiabilityEntries              SuperAdminLiabilityEntry[]
  superAdminTransfersFrom                 SuperAdminAccountTransfer[]              @relation("SuperAdminTransferFromCurrency")
  superAdminTransfersTo                   SuperAdminAccountTransfer[]              @relation("SuperAdminTransferToCurrency")

  @@map("currencies")
}

enum ExchangeRateEntryMethod {
  manual
  api
}

model ExchangeRate {
  id             Int                     @id @default(autoincrement())
  rateDate       DateTime                @map("rate_date") @db.Date
  fromCurrencyId Int                     @map("from_currency_id")
  toCurrencyId   Int                     @map("to_currency_id")
  buyRate        Decimal?                @map("buy_rate") @db.Decimal(18, 6)
  sellRate       Decimal?                @map("sell_rate") @db.Decimal(18, 6)
  referenceRate  Decimal                 @map("reference_rate") @db.Decimal(18, 6)
  source         String                  @default("manual_open_market") @db.VarChar(100)
  entryMethod    ExchangeRateEntryMethod @default(manual) @map("entry_method")
  correctionOfId Int?                    @map("correction_of_id")
  notes          String?                 @db.Text
  createdBy      Int?                    @map("created_by")
  createdAt      DateTime                @default(now()) @map("created_at")

  fromCurrency Currency             @relation("ExchangeRateFromCurrency", fields: [fromCurrencyId], references: [id], onDelete: Restrict)
  toCurrency   Currency             @relation("ExchangeRateToCurrency", fields: [toCurrencyId], references: [id], onDelete: Restrict)
  correctionOf ExchangeRate?        @relation("ExchangeRateCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  corrections  ExchangeRate[]       @relation("ExchangeRateCorrection")
  sbpSnapshots SbpDailyFxSnapshot[]

  @@unique([rateDate, fromCurrencyId, toCurrencyId, source], map: "exchange_rates_date_currency_source_key")
  @@index([fromCurrencyId, toCurrencyId, rateDate], map: "exchange_rates_currency_date_idx")
  @@map("exchange_rates")
}

model SarafiAfFxSnapshot {
  id                     Int       @id @default(autoincrement())
  snapshotDate           DateTime  @map("snapshot_date") @db.Date
  scheduledTime          String    @default("08:30") @map("scheduled_time") @db.VarChar(20)
  timezone               String    @default("Asia/Kabul") @db.VarChar(80)
  provider               String    @default("SARAFI_AF") @db.VarChar(80)
  market                 String    @default("sarai_shahzada") @db.VarChar(120)
  providerMode           String    @default("FOUNDATION_ONLY") @map("provider_mode") @db.VarChar(80)
  fetchedAt              DateTime  @map("fetched_at")
  sourceTimestamp        DateTime? @map("source_timestamp")
  sourceAgeMinutes       Int?      @map("source_age_minutes")
  status                 String    @db.VarChar(80)
  rawReference           String?   @map("raw_reference") @db.VarChar(240)
  rawPayloadHash         String?   @map("raw_payload_hash") @db.VarChar(120)
  validationWarningsJson Json?     @map("validation_warnings_json")
  idempotencyKey         String    @unique @map("idempotency_key") @db.VarChar(240)
  createdBy              Int?      @map("created_by")
  createdAt              DateTime  @default(now()) @map("created_at")

  quotes       SarafiAfFxSnapshotQuote[]
  derivedRates SarafiAfFxDerivedRate[]

  @@unique([snapshotDate, provider, market, scheduledTime], map: "sarafi_af_fx_snapshots_daily_key")
  @@index([snapshotDate, status], map: "sarafi_af_fx_snapshots_date_status_idx")
  @@map("sarafi_af_fx_snapshots")
}

model SarafiAfFxSnapshotQuote {
  id                  Int      @id @default(autoincrement())
  snapshotId          Int      @map("snapshot_id")
  baseCurrencyId      Int      @map("base_currency_id")
  quoteCurrencyId     Int      @map("quote_currency_id")
  rawBuyRate          Decimal  @map("raw_buy_rate") @db.Decimal(18, 8)
  rawSellRate         Decimal  @map("raw_sell_rate") @db.Decimal(18, 8)
  rawUnit             String   @default("1") @map("raw_unit") @db.VarChar(40)
  normalizationFactor Decimal  @default(1) @map("normalization_factor") @db.Decimal(18, 8)
  normalizedBuyRate   Decimal  @map("normalized_buy_rate") @db.Decimal(18, 8)
  normalizedSellRate  Decimal  @map("normalized_sell_rate") @db.Decimal(18, 8)
  createdAt           DateTime @default(now()) @map("created_at")

  snapshot      SarafiAfFxSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  baseCurrency  Currency           @relation("SarafiAfSnapshotQuoteBaseCurrency", fields: [baseCurrencyId], references: [id], onDelete: Restrict)
  quoteCurrency Currency           @relation("SarafiAfSnapshotQuoteQuoteCurrency", fields: [quoteCurrencyId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, baseCurrencyId, quoteCurrencyId], map: "sarafi_af_fx_snapshot_quotes_pair_key")
  @@index([baseCurrencyId, quoteCurrencyId], map: "sarafi_af_fx_snapshot_quotes_currency_idx")
  @@map("sarafi_af_fx_snapshot_quotes")
}

model SarafiAfFxDerivedRate {
  id                 Int      @id @default(autoincrement())
  snapshotId         Int      @map("snapshot_id")
  fromCurrencyId     Int      @map("from_currency_id")
  toCurrencyId       Int      @map("to_currency_id")
  buyRate            Decimal  @map("buy_rate") @db.Decimal(18, 8)
  sellRate           Decimal  @map("sell_rate") @db.Decimal(18, 8)
  conversionPathJson Json     @map("conversion_path_json")
  sourceRatesJson    Json     @map("source_rates_json")
  createdAt          DateTime @default(now()) @map("created_at")

  snapshot     SarafiAfFxSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  fromCurrency Currency           @relation("SarafiAfDerivedFromCurrency", fields: [fromCurrencyId], references: [id], onDelete: Restrict)
  toCurrency   Currency           @relation("SarafiAfDerivedToCurrency", fields: [toCurrencyId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, fromCurrencyId, toCurrencyId], map: "sarafi_af_fx_derived_rates_pair_key")
  @@index([fromCurrencyId, toCurrencyId], map: "sarafi_af_fx_derived_rates_currency_idx")
  @@map("sarafi_af_fx_derived_rates")
}

model SarafiAfAssistedCaptureDraft {
  id                     Int       @id @default(autoincrement())
  snapshotDate           DateTime  @map("snapshot_date") @db.Date
  scheduledTime          String    @default("08:30") @map("scheduled_time") @db.VarChar(20)
  timezone               String    @default("Asia/Kabul") @db.VarChar(80)
  provider               String    @default("SARAFI_AF") @db.VarChar(80)
  market                 String    @default("sarai_shahzada") @db.VarChar(120)
  sourceUrl              String    @map("source_url") @db.VarChar(500)
  fetchedAt              DateTime  @map("fetched_at")
  sourceTimestamp        DateTime  @map("source_timestamp")
  status                 String    @default("PENDING_REVIEW") @db.VarChar(80)
  rawPayloadHash         String    @map("raw_payload_hash") @db.VarChar(64)
  rawHtmlStorageKey      String?   @map("raw_html_storage_key") @db.VarChar(500)
  screenshotStorageKey   String?   @map("screenshot_storage_key") @db.VarChar(500)
  evidenceExpiresAt      DateTime  @map("evidence_expires_at")
  evidenceDeletedAt      DateTime? @map("evidence_deleted_at")
  quotesJson             Json      @map("quotes_json")
  validationWarningsJson Json?     @map("validation_warnings_json")
  idempotencyKey         String    @unique @map("idempotency_key") @db.VarChar(240)
  reviewedBy             Int?      @map("reviewed_by")
  reviewedAt             DateTime? @map("reviewed_at")
  reviewNotes            String?   @map("review_notes") @db.Text
  approvedSnapshotId     Int?      @unique @map("approved_snapshot_id")
  createdAt              DateTime  @default(now()) @map("created_at")

  @@index([snapshotDate, status], map: "sarafi_af_capture_drafts_date_status_idx")
  @@map("sarafi_af_assisted_capture_drafts")
}

model SbpDailyFxSnapshot {
  id                   Int       @id @default(autoincrement())
  rateDate             DateTime  @map("rate_date") @db.Date
  provider             String    @default("SBP") @db.VarChar(80)
  market               String    @default("weighted_average_customer") @db.VarChar(120)
  sourceUrl            String    @map("source_url") @db.VarChar(500)
  fetchedAt            DateTime  @map("fetched_at")
  buyRate              Decimal   @map("buy_rate") @db.Decimal(18, 6)
  sellRate             Decimal   @map("sell_rate") @db.Decimal(18, 6)
  referenceRate        Decimal   @map("reference_rate") @db.Decimal(18, 6)
  status               String    @db.VarChar(80)
  rawPayloadHash       String    @map("raw_payload_hash") @db.VarChar(64)
  rawHtmlStorageKey    String?   @map("raw_html_storage_key") @db.VarChar(500)
  screenshotStorageKey String?   @map("screenshot_storage_key") @db.VarChar(500)
  evidenceExpiresAt    DateTime  @map("evidence_expires_at")
  evidenceDeletedAt    DateTime? @map("evidence_deleted_at")
  exchangeRateId       Int       @unique @map("exchange_rate_id")
  createdAt            DateTime  @default(now()) @map("created_at")

  exchangeRate ExchangeRate @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)

  @@unique([rateDate, provider, market], map: "sbp_daily_fx_snapshots_date_provider_market_key")
  @@index([rateDate, status], map: "sbp_daily_fx_snapshots_date_status_idx")
  @@index([evidenceExpiresAt, evidenceDeletedAt], map: "sbp_daily_fx_snapshots_evidence_expiry_idx")
  @@map("sbp_daily_fx_snapshots")
}

model CountryFallbackExchangeRate {
  id             Int      @id @default(autoincrement())
  countryId      Int      @map("country_id")
  fromCurrencyId Int      @map("from_currency_id")
  toCurrencyId   Int      @map("to_currency_id")
  rate           Decimal  @db.Decimal(18, 6)
  effectiveFrom  DateTime @map("effective_from") @db.Date
  isActive       Boolean  @default(true) @map("is_active")
  notes          String?  @db.Text
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  country      Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  fromCurrency Currency @relation("CountryFallbackFromCurrency", fields: [fromCurrencyId], references: [id], onDelete: Restrict)
  toCurrency   Currency @relation("CountryFallbackToCurrency", fields: [toCurrencyId], references: [id], onDelete: Restrict)
  creator      User?    @relation("CountryFallbackRateCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([countryId, fromCurrencyId, toCurrencyId, effectiveFrom], map: "country_fallback_rates_country_currency_date_key")
  @@index([countryId, fromCurrencyId, toCurrencyId, isActive], map: "country_fallback_rates_active_idx")
  @@map("country_fallback_exchange_rates")
}

model City {
  id        Int      @id @default(autoincrement())
  countryId Int      @map("country_id")
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  country                          Country                           @relation(fields: [countryId], references: [id])
  cityCurrencies                   CityCurrency[]
  users                            User[]
  godowns                          Godown[]
  customers                        Customer[]
  sales                            Sale[]
  payments                         Payment[]
  expenses                         Expense[]
  personalWithdrawals              PersonalWithdrawal[]
  withdraweeNames                  WithdraweeName[]
  hajiTransfers                    HajiTransfer[]
  lotCityDistributions             LotCityDistribution[]
  inventoryThresholds              InventoryThreshold[]
  voucherSequence                  VoucherSequence?
  auditLogs                        AuditLog[]
  lotSettlementOverflows           LotSettlementOverflow[]
  lotSettlementUnresolvedOverflows LotSettlementUnresolvedOverflow[]
  cityTransfersFrom                CityTransfer[]                    @relation("TransferFromCity")
  cityTransfersTo                  CityTransfer[]                    @relation("TransferToCity")
  accounts                         Account[]
  agentPayments                    AgentPayment[]
  superAdminLiabilityEntries       SuperAdminLiabilityEntry[]
  agents                           Agent[]
  godownAccessFrom                 CityGodownPermission[]            @relation("GodownAccessFrom")
  godownAccessTo                   CityGodownPermission[]            @relation("GodownAccessTo")
  bankAccounts                     BankAccount[]
  bankDeposits                     BankDeposit[]
  intermediaryDeposits             IntermediaryDeposit[]
  openingCashes                    OpeningCash[]
  openingStocks                    OpeningStock[]
  openingBankBalances              OpeningBankBalance[]
  openingCheques                   OpeningCheque[]
  openingHajiBalances              OpeningHajiBalance[]
  cityLiabilityAccounts            CityLiabilityAccount[]
  cityLiabilityEntries             CityLiabilityEntry[]
  openingCityLiabilities           OpeningCityLiability[]
  consignees                       Consignee[]
  destinationLots                  Lot[]                             @relation("LotDestinationCity")

  @@unique([countryId, name])
  @@index([countryId])
  @@map("cities")
}

model CityGodownPermission {
  id         Int      @id @default(autoincrement())
  fromCityId Int      @map("from_city_id")
  toCityId   Int      @map("to_city_id")
  createdAt  DateTime @default(now()) @map("created_at")

  fromCity City @relation("GodownAccessFrom", fields: [fromCityId], references: [id], onDelete: Cascade)
  toCity   City @relation("GodownAccessTo", fields: [toCityId], references: [id], onDelete: Cascade)

  @@unique([fromCityId, toCityId], name: "unique_city_godown_perm")
  @@index([fromCityId])
  @@map("city_godown_permissions")
}

model CityCurrency {
  id         Int @id @default(autoincrement())
  cityId     Int @map("city_id")
  currencyId Int @map("currency_id")

  city     City     @relation(fields: [cityId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  @@unique([cityId, currencyId])
  @@map("city_currencies")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(200)
  role         UserRole
  cityId       Int?     @map("city_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  city                               City?                             @relation(fields: [cityId], references: [id])
  lotsCreated                        Lot[]                             @relation("LotCreatedBy")
  lotsCompleted                      Lot[]                             @relation("LotCompletedBy")
  salesCreated                       Sale[]                            @relation("SaleCreatedBy")
  salesCancelled                     Sale[]                            @relation("SaleCancelledBy")
  paymentsCreated                    Payment[]                         @relation("PaymentCreatedBy")
  paymentsCancelled                  Payment[]                         @relation("PaymentCancelledBy")
  expensesCreated                    Expense[]
  personalWithdrawals                PersonalWithdrawal[]              @relation("WithdrawalCreator")
  withdrawalsApproved                PersonalWithdrawal[]              @relation("WithdrawalApprover")
  withdraweeNamesCreated             WithdraweeName[]                  @relation("WithdraweeNameCreator")
  hajiTransfers                      HajiTransfer[]
  godownTransfers                    GodownTransfer[]
  attachments                        Attachment[]
  consigneesCreated                  Consignee[]                       @relation("ConsigneeCreatedBy")
  lotDocumentsUploaded               LotDocument[]                     @relation("LotDocumentUploadedBy")
  lotDocumentsArchived               LotDocument[]                     @relation("LotDocumentArchivedBy")
  lotStatusHistoryChanged            LotStatusHistory[]                @relation("LotStatusHistoryChangedBy")
  auditLogs                          AuditLog[]
  inventoryThresholds                InventoryThreshold[]
  saleDiscounts                      SaleDiscount[]
  paymentLotTransfers                PaymentLotTransfer[]
  lotSettlementOverflows             LotSettlementOverflow[]
  lotSettlementUnresolvedOverflows   LotSettlementUnresolvedOverflow[]
  purchasesCreated                   LotPurchase[]                     @relation("PurchaseCreatedBy")
  openingCashes                      OpeningCash[]
  openingCustomerBalances            OpeningCustomerBalance[]
  openingStocks                      OpeningStock[]
  openingLiabilities                 OpeningLiability[]
  cityLiabilityAccounts              CityLiabilityAccount[]
  cityLiabilityEntries               CityLiabilityEntry[]
  openingCityLiabilities             OpeningCityLiability[]
  openingBankBalances                OpeningBankBalance[]
  openingCheques                     OpeningCheque[]
  openingHajiBalances                OpeningHajiBalance[]
  openingInventoryValuations         OpeningInventoryValuation[]
  openingSuperAdminAccountBalances   OpeningSuperAdminAccountBalance[]
  openingEquityAllocations           OpeningEquityAllocation[]
  costsCreated                       LotCost[]                         @relation("CostCreatedBy")
  supplierPaymentsCreated            SupplierPayment[]                 @relation("SupplierPaymentCreatedBy")
  shippingLinePaymentsCreated        ShippingLinePayment[]             @relation("ShippingLinePaymentCreatedBy")
  cityTransfersSent                  CityTransfer[]                    @relation("TransferSentBy")
  cityTransfersApproved              CityTransfer[]                    @relation("TransferApprovedBy")
  agentPaymentsCreated               AgentPayment[]                    @relation("AgentPaymentCreatedBy")
  sessions                           UserSession[]
  investorsCreated                   Investor[]
  investorAccountsCreated            InvestorAccount[]
  investorDepositsCreated            InvestorDeposit[]
  investorWithdrawalsCreated         InvestorWithdrawal[]
  profitAllocationsCreated           ProfitAllocation[]
  intermediaryDepositsCreated        IntermediaryDeposit[]
  hajiCashReceiptsCreated            HajiCashReceipt[]
  intermediaryExchangesCreated       IntermediaryExchange[]            @relation("IntermediaryExchangeCreatedBy")
  intermediaryExchangesDeleted       IntermediaryExchange[]            @relation("IntermediaryExchangeDeletedBy")
  superAdminBankAccountsCreated      SuperAdminBankAccount[]
  superAdminPersonalExpensesCreated  SuperAdminPersonalExpense[]
  superAdminLiabilityAccountsCreated SuperAdminLiabilityAccount[]
  superAdminLiabilityEntriesCreated  SuperAdminLiabilityEntry[]        @relation("SuperAdminLiabilityEntryCreatedBy")
  superAdminLiabilityEntriesReversed SuperAdminLiabilityEntry[]        @relation("SuperAdminLiabilityEntryReversedBy")
  superAdminAccountTransfersCreated  SuperAdminAccountTransfer[]       @relation("SuperAdminAccountTransferCreatedBy")
  superAdminAccountTransfersReversed SuperAdminAccountTransfer[]       @relation("SuperAdminAccountTransferReversedBy")
  countryFallbackRatesCreated        CountryFallbackExchangeRate[]     @relation("CountryFallbackRateCreatedBy")
  syncRequestsCreated                SyncRequest[]                     @relation("SyncRequestCreatedBy")

  @@index([cityId])
  @@index([role])
  @@map("users")
}

// ============================================================
// USER SESSIONS
// ============================================================

model UserSession {
  id           String   @id @default(cuid())
  userId       Int      @map("user_id")
  tokenHash    String   @map("token_hash") @db.VarChar(255)
  deviceInfo   String?  @map("device_info") @db.VarChar(500)
  ipAddress    String?  @map("ip_address") @db.VarChar(50)
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  expiresAt    DateTime @map("expires_at")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

