generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  super_admin
  city_admin
}

enum LotStatus {
  ongoing
  completed
}

enum SaleStatus {
  active
  cancelled
  marked_short
}

enum PaymentStatus {
  active
  cancelled
}

enum PaymentMethod {
  cash
  cheque
  bank_transfer
  online
}

enum PaymentDestination {
  haji
  our_account
}

enum HajiTransferType {
  direct
  from_in_hand
}

enum SupplierPaymentMethod {
  bank_transfer
  tt
  lc
  cash
  other
}

enum LotCostType {
  purchase_price
  freight
  customs_duty
  port_charges
  transport
  loading_unloading
  insurance
  other
}

enum EntityType {
  sale
  payment
  godown_transfer
  expense
  haji_transfer
}

enum AuditAction {
  create
  update
  delete
  cancel
  restore
  hard_delete
}

// ============================================================
// CORE TABLES
// ============================================================

model Country {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")

  cities City[]
  lots   Lot[]

  @@map("countries")
}

model Currency {
  id     Int    @id @default(autoincrement())
  code   String @unique @db.VarChar(10)
  name   String @db.VarChar(100)
  symbol String @db.VarChar(10)

  cityCurrencies      CityCurrency[]
  sales               Sale[]
  payments            Payment[]
  expenses            Expense[]
  personalWithdrawals PersonalWithdrawal[]
  hajiTransfers       HajiTransfer[]
  saleDiscounts       SaleDiscount[]
  lotSettlementOverflows LotSettlementOverflow[]

  @@map("currencies")
}

model City {
  id        Int      @id @default(autoincrement())
  countryId Int      @map("country_id")
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  country            Country              @relation(fields: [countryId], references: [id])
  cityCurrencies     CityCurrency[]
  users              User[]
  godowns            Godown[]
  customers          Customer[]
  sales              Sale[]
  payments           Payment[]
  expenses           Expense[]
  personalWithdrawals PersonalWithdrawal[]
  hajiTransfers      HajiTransfer[]
  lotCityDistributions LotCityDistribution[]
  inventoryThresholds InventoryThreshold[]
  voucherSequence    VoucherSequence?
  auditLogs          AuditLog[]
  lotSettlementOverflows LotSettlementOverflow[]
  notifications      Notification[]
  cityTransfersFrom  CityTransfer[] @relation("TransferFromCity")
  cityTransfersTo    CityTransfer[] @relation("TransferToCity")
  accounts           Account[]
  agentPayments      AgentPayment[]
  agents             Agent[]
  godownAccessFrom   CityGodownPermission[] @relation("GodownAccessFrom")
  godownAccessTo     CityGodownPermission[] @relation("GodownAccessTo")
  chatThreads        ChatThread[]

  @@unique([countryId, name])
  @@index([countryId])
  @@map("cities")
}

model CityGodownPermission {
  id          Int      @id @default(autoincrement())
  fromCityId  Int      @map("from_city_id")
  toCityId    Int      @map("to_city_id")
  createdAt   DateTime @default(now()) @map("created_at")

  fromCity City @relation("GodownAccessFrom", fields: [fromCityId], references: [id], onDelete: Cascade)
  toCity   City @relation("GodownAccessTo",   fields: [toCityId],   references: [id], onDelete: Cascade)

  @@unique([fromCityId, toCityId], name: "unique_city_godown_perm")
  @@index([fromCityId])
  @@map("city_godown_permissions")
}

model CityCurrency {
  id         Int @id @default(autoincrement())
  cityId     Int @map("city_id")
  currencyId Int @map("currency_id")

  city     City     @relation(fields: [cityId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  @@unique([cityId, currencyId])
  @@map("city_currencies")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(200)
  role         UserRole
  cityId       Int?     @map("city_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  city               City?               @relation(fields: [cityId], references: [id])
  lotsCreated        Lot[]               @relation("LotCreatedBy")
  lotsCompleted      Lot[]               @relation("LotCompletedBy")
  salesCreated       Sale[]              @relation("SaleCreatedBy")
  salesCancelled     Sale[]              @relation("SaleCancelledBy")
  paymentsCreated    Payment[]           @relation("PaymentCreatedBy")
  paymentsCancelled  Payment[]           @relation("PaymentCancelledBy")
  expensesCreated       Expense[]
  personalWithdrawals   PersonalWithdrawal[]  @relation("WithdrawalCreator")
  withdrawalsApproved   PersonalWithdrawal[]  @relation("WithdrawalApprover")
  hajiTransfers         HajiTransfer[]
  godownTransfers    GodownTransfer[]
  attachments        Attachment[]
  auditLogs          AuditLog[]
  inventoryThresholds InventoryThreshold[]
  saleDiscounts      SaleDiscount[]
  paymentLotTransfers PaymentLotTransfer[]
  lotSettlementOverflows LotSettlementOverflow[]
  notifications      Notification[]
  purchasesCreated   LotPurchase[]  @relation("PurchaseCreatedBy")
  costsCreated       LotCost[]      @relation("CostCreatedBy")
  supplierPaymentsCreated SupplierPayment[] @relation("SupplierPaymentCreatedBy")
  cityTransfersSent      CityTransfer[] @relation("TransferSentBy")
  cityTransfersApproved  CityTransfer[] @relation("TransferApprovedBy")
  agentPaymentsCreated   AgentPayment[] @relation("AgentPaymentCreatedBy")
  sessions               UserSession[]
  messagesSent           ChatMessage[]  @relation("MessagesSent")

  @@index([cityId])
  @@index([role])
  @@map("users")
}

// ============================================================
// USER SESSIONS
// ============================================================

model UserSession {
  id           String   @id @default(cuid())
  userId       Int      @map("user_id")
  tokenHash    String   @map("token_hash") @db.VarChar(255)
  deviceInfo   String?  @map("device_info") @db.VarChar(500)
  ipAddress    String?  @map("ip_address") @db.VarChar(50)
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  expiresAt    DateTime @map("expires_at")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@index([isActive])
  @@map("user_sessions")
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lotProducts          LotProduct[]
  lotCityDistributions LotCityDistribution[]
  lotCityGodownAllocations LotCityGodownAllocation[] @relation("ProductGodownAlloc")
  saleItems            SaleItem[]
  godownTransfers      GodownTransfer[]
  inventoryThresholds  InventoryThreshold[]
  lotPurchases         LotPurchase[]
  cityTransfers        CityTransfer[]

  @@map("products")
}

// ============================================================
// GODOWNS
// ============================================================

model Godown {
  id        Int      @id @default(autoincrement())
  cityId    Int      @map("city_id")
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city                     City                      @relation(fields: [cityId], references: [id])
  sales                    Sale[]
  godownTransfersFrom      GodownTransfer[]           @relation("TransferFrom")
  godownTransfersTo        GodownTransfer[]           @relation("TransferTo")
  lotCityGodownAllocations LotCityGodownAllocation[]
  cityTransfersFrom  CityTransfer[] @relation("TransferFromGodown")
  cityTransfersTo    CityTransfer[] @relation("TransferToGodown")

  @@unique([cityId, name])
  @@index([cityId])
  @@map("godowns")
}

model GodownTransfer {
  id            Int      @id @default(autoincrement())
  fromGodownId  Int      @map("from_godown_id")
  toGodownId    Int      @map("to_godown_id")
  productId     Int      @map("product_id")
  lotId         Int      @map("lot_id")
  qty           Decimal  @db.Decimal(12, 2)
  transferDate  DateTime @map("transfer_date") @db.Date
  notes         String?  @db.Text
  createdBy     Int      @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  fromGodown Godown  @relation("TransferFrom", fields: [fromGodownId], references: [id])
  toGodown   Godown  @relation("TransferTo", fields: [toGodownId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
  lot        Lot     @relation(fields: [lotId], references: [id])
  creator    User    @relation(fields: [createdBy], references: [id])

  attachments Attachment[]

  @@index([fromGodownId])
  @@index([toGodownId])
  @@index([lotId])
  @@map("godown_transfers")
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id        Int      @id @default(autoincrement())
  cityId    Int      @map("city_id")
  name      String   @db.VarChar(200)
  phone     String?  @db.VarChar(50)
  address   String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city     City      @relation(fields: [cityId], references: [id])
  sales    Sale[]
  payments Payment[]

  @@index([cityId])
  @@index([name])
  @@map("customers")
}

// ============================================================
// LOTS
// ============================================================

model Lot {
  id          Int       @id @default(autoincrement())
  countryId   Int       @map("country_id")
  lotNumber   String    @map("lot_number") @db.VarChar(50)
  lotDate     DateTime  @map("lot_date") @db.Date
  notes       String?   @db.Text
  status      LotStatus @default(ongoing)
  createdBy   Int       @map("created_by")
  completedBy Int?      @map("completed_by")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  country            Country              @relation(fields: [countryId], references: [id])
  creator            User                 @relation("LotCreatedBy", fields: [createdBy], references: [id])
  completer          User?                @relation("LotCompletedBy", fields: [completedBy], references: [id])
  lotProducts        LotProduct[]
  lotCityDistributions LotCityDistribution[]
  sales              Sale[]
  payments           Payment[]
  expenses           Expense[]
  hajiTransfers      HajiTransfer[]
  godownTransfers    GodownTransfer[]
  saleDiscounts      SaleDiscount[]
  paymentLotTransfersFrom PaymentLotTransfer[] @relation("TransferFromLot")
  paymentLotTransfersTo   PaymentLotTransfer[] @relation("TransferToLot")
  lotSettlementOverflowsFrom LotSettlementOverflow[] @relation("OverflowFromLot")
  lotSettlementOverflowsTo   LotSettlementOverflow[] @relation("OverflowToLot")
  lotPurchases               LotPurchase[]
  lotCosts                   LotCost[]
  supplierPayments           SupplierPayment[]
  cityTransfers              CityTransfer[]

  @@unique([countryId, lotNumber])
  @@index([countryId])
  @@index([status])
  @@index([lotDate])
  @@map("lots")
}

model LotProduct {
  id        Int      @id @default(autoincrement())
  lotId     Int      @map("lot_id")
  productId Int      @map("product_id")
  totalQty  Decimal  @map("total_qty") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lot     Lot     @relation(fields: [lotId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([lotId, productId])
  @@index([lotId])
  @@map("lot_products")
}

model LotCityDistribution {
  id           Int      @id @default(autoincrement())
  lotId        Int      @map("lot_id")
  cityId       Int      @map("city_id")
  productId    Int      @map("product_id")
  allocatedQty Decimal  @map("allocated_qty") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lot     Lot     @relation(fields: [lotId], references: [id])
  city    City    @relation(fields: [cityId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  godownAllocations LotCityGodownAllocation[]

  @@unique([lotId, cityId, productId])
  @@index([lotId])
  @@index([cityId])
  @@map("lot_city_distributions")
}

model LotCityGodownAllocation {
  id                      Int      @id @default(autoincrement())
  lotCityDistributionId   Int      @map("lot_city_distribution_id")
  godownId                Int      @map("godown_id")
  productId               Int      @map("product_id")
  qty                     Decimal  @db.Decimal(12, 2)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  lotCityDistribution LotCityDistribution @relation(fields: [lotCityDistributionId], references: [id])
  godown              Godown               @relation(fields: [godownId], references: [id])
  product             Product              @relation("ProductGodownAlloc", fields: [productId], references: [id])

  @@unique([lotCityDistributionId, godownId])
  @@index([lotCityDistributionId])
  @@index([godownId])
  @@map("lot_city_godown_allocations")
}

// ============================================================
// SALES
// ============================================================

model VoucherSequence {
  id            Int @id @default(autoincrement())
  cityId        Int @unique @map("city_id")
  currentNumber Int @default(0) @map("current_number")

  city City @relation(fields: [cityId], references: [id])

  @@map("voucher_sequences")
}

model Sale {
  id                Int        @id @default(autoincrement())
  cityId            Int        @map("city_id")
  customerId        Int        @map("customer_id")
  lotId             Int        @map("lot_id")
  godownId          Int        @map("godown_id")
  voucherNo         String     @map("voucher_no") @db.VarChar(10)
  saleDate          DateTime   @map("sale_date") @db.Date
  totalAmount       Decimal    @default(0) @map("total_amount") @db.Decimal(15, 2)
  currencyId        Int        @map("currency_id")
  notes             String?    @db.Text
  status            SaleStatus @default(active)
  stockShortFlag    Boolean    @default(false) @map("stock_short_flag")
  cancellationReason String?   @map("cancellation_reason") @db.Text
  cancelledAt       DateTime?  @map("cancelled_at")
  cancelledBy       Int?       @map("cancelled_by")
  createdBy         Int        @map("created_by")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  city       City     @relation(fields: [cityId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  lot        Lot      @relation(fields: [lotId], references: [id])
  godown     Godown   @relation(fields: [godownId], references: [id])
  currency   Currency @relation(fields: [currencyId], references: [id])
  creator    User     @relation("SaleCreatedBy", fields: [createdBy], references: [id])
  canceller  User?    @relation("SaleCancelledBy", fields: [cancelledBy], references: [id])

  items       SaleItem[]
  discounts   SaleDiscount[]
  attachments Attachment[]

  @@index([cityId])
  @@index([customerId])
  @@index([lotId])
  @@index([godownId])
  @@index([saleDate])
  @@index([status])
  @@index([cityId, voucherNo])
  @@map("sales")
}

model SaleItem {
  id            Int     @id @default(autoincrement())
  saleId        Int     @map("sale_id")
  productId     Int     @map("product_id")
  qty           Decimal @db.Decimal(12, 2)
  ratePerCarton Decimal @map("rate_per_carton") @db.Decimal(12, 2)
  amount        Decimal @db.Decimal(15, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SaleDiscount {
  id              Int      @id @default(autoincrement())
  saleId          Int      @map("sale_id")
  discountAmount  Decimal  @map("discount_amount") @db.Decimal(15, 2)
  currencyId      Int      @map("currency_id")
  appliedToLotId  Int      @map("applied_to_lot_id")
  notes           String?  @db.Text
  discountDate    DateTime @map("discount_date") @db.Date
  createdBy       Int      @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  sale          Sale     @relation(fields: [saleId], references: [id])
  currency      Currency @relation(fields: [currencyId], references: [id])
  appliedToLot  Lot      @relation(fields: [appliedToLotId], references: [id])
  creator       User     @relation(fields: [createdBy], references: [id])

  @@index([saleId])
  @@index([appliedToLotId])
  @@map("sale_discounts")
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id                 Int                @id @default(autoincrement())
  cityId             Int                @map("city_id")
  customerId         Int                @map("customer_id")
  lotId              Int                @map("lot_id")
  paymentDate        DateTime           @map("payment_date") @db.Date
  detail             String             @db.VarChar(500)
  amount             Decimal            @db.Decimal(15, 2)
  currencyId         Int                @map("currency_id")
  exchangeRate       Decimal?           @map("exchange_rate") @db.Decimal(12, 4)
  usdEquivalent      Decimal?           @map("usd_equivalent") @db.Decimal(15, 2)
  manualVoucherNo    String?            @map("manual_voucher_no") @db.VarChar(50)
  paymentMethod      PaymentMethod      @map("payment_method")
  destination        PaymentDestination
  notes              String?            @db.Text
  status             PaymentStatus      @default(active)
  cancellationReason String?            @map("cancellation_reason") @db.Text
  cancelledAt        DateTime?          @map("cancelled_at")
  cancelledBy        Int?               @map("cancelled_by")
  createdBy          Int                @map("created_by")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  city       City     @relation(fields: [cityId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  lot        Lot      @relation(fields: [lotId], references: [id])
  currency   Currency @relation(fields: [currencyId], references: [id])
  creator    User     @relation("PaymentCreatedBy", fields: [createdBy], references: [id])
  canceller  User?    @relation("PaymentCancelledBy", fields: [cancelledBy], references: [id])

  attachments        Attachment[]
  paymentLotTransfers PaymentLotTransfer[]

  @@index([cityId])
  @@index([customerId])
  @@index([lotId])
  @@index([paymentDate])
  @@index([status])
  @@index([paymentMethod])
  @@map("payments")
}

model PaymentLotTransfer {
  id            Int      @id @default(autoincrement())
  paymentId     Int      @map("payment_id")
  fromLotId     Int      @map("from_lot_id")
  toLotId       Int      @map("to_lot_id")
  transferredBy Int      @map("transferred_by")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  payment     Payment @relation(fields: [paymentId], references: [id])
  fromLot     Lot     @relation("TransferFromLot", fields: [fromLotId], references: [id])
  toLot       Lot     @relation("TransferToLot", fields: [toLotId], references: [id])
  transferrer User    @relation(fields: [transferredBy], references: [id])

  @@index([paymentId])
  @@index([fromLotId])
  @@index([toLotId])
  @@map("payment_lot_transfers")
}

// ============================================================
// EXPENSES
// ============================================================

model Expense {
  id          Int       @id @default(autoincrement())
  cityId      Int       @map("city_id")
  lotId       Int       @map("lot_id")
  expenseDate DateTime  @map("expense_date") @db.Date
  amount      Decimal   @db.Decimal(15, 2)
  currencyId  Int       @map("currency_id")
  detail      String    @db.VarChar(500)
  notes       String?   @db.Text
  createdBy   Int       @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at") // null = active; non-null = soft-deleted

  city        City         @relation(fields: [cityId], references: [id])
  lot         Lot          @relation(fields: [lotId], references: [id])
  currency    Currency     @relation(fields: [currencyId], references: [id])
  creator     User         @relation(fields: [createdBy], references: [id])
  attachments Attachment[]

  @@index([cityId])
  @@index([lotId])
  @@index([expenseDate])
  @@index([deletedAt])
  @@map("expenses")
}

// ============================================================
// PERSONAL WITHDRAWALS
// ============================================================

model PersonalWithdrawal {
  id             Int       @id @default(autoincrement())
  cityId         Int       @map("city_id")
  withdrawalDate DateTime  @map("withdrawal_date") @db.Date
  amount         Decimal   @db.Decimal(15, 2)
  currencyId     Int       @map("currency_id")
  detail         String    @db.VarChar(500)
  withdrawnBy    String?   @map("withdrawn_by") @db.VarChar(100)
  notes          String?   @db.Text
  approvedBy     Int?      @map("approved_by")
  approvedAt     DateTime? @map("approved_at")
  hajiTransferId Int?      @unique @map("haji_transfer_id")
  createdBy      Int       @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  city         City          @relation(fields: [cityId], references: [id])
  currency     Currency      @relation(fields: [currencyId], references: [id])
  creator      User          @relation("WithdrawalCreator", fields: [createdBy], references: [id])
  approver     User?         @relation("WithdrawalApprover", fields: [approvedBy], references: [id])
  hajiTransfer HajiTransfer? @relation(fields: [hajiTransferId], references: [id])

  @@index([cityId])
  @@index([withdrawalDate])
  @@index([approvedBy])
  @@map("personal_withdrawals")
}

// ============================================================
// HAJI TRANSFERS
// ============================================================

model HajiTransfer {
  id           Int              @id @default(autoincrement())
  cityId       Int              @map("city_id")
  lotId        Int              @map("lot_id")
  transferDate DateTime         @map("transfer_date") @db.Date
  amount       Decimal          @db.Decimal(15, 2)
  currencyId   Int              @map("currency_id")
  detail        String           @db.VarChar(500)
  transferType  HajiTransferType @map("transfer_type")
  transferredTo String?          @map("transferred_to") @db.VarChar(100)
  notes         String?          @db.Text
  createdBy     Int              @map("created_by")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  city     City     @relation(fields: [cityId], references: [id])
  lot      Lot      @relation(fields: [lotId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])
  creator  User     @relation(fields: [createdBy], references: [id])

  withdrawalSource PersonalWithdrawal?
  attachments      Attachment[]

  @@index([cityId])
  @@index([lotId])
  @@index([transferDate])
  @@index([transferredTo])
  @@map("haji_transfers")
}

model LotSettlementOverflow {
  id             Int      @id @default(autoincrement())
  cityId         Int      @map("city_id")
  fromLotId      Int      @map("from_lot_id")
  toLotId        Int      @map("to_lot_id")
  overflowAmount Decimal  @map("overflow_amount") @db.Decimal(15, 2)
  currencyId     Int      @map("currency_id")
  notes          String?  @db.Text
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  city     City     @relation(fields: [cityId], references: [id])
  fromLot  Lot      @relation("OverflowFromLot", fields: [fromLotId], references: [id])
  toLot    Lot      @relation("OverflowToLot", fields: [toLotId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])
  creator  User     @relation(fields: [createdBy], references: [id])

  @@index([cityId])
  @@index([fromLotId])
  @@index([toLotId])
  @@map("lot_settlement_overflows")
}

// ============================================================
// ACCOUNTING - Chart of Accounts & Journal Entries
// ============================================================

enum AccountType {
  asset
  liability
  revenue
  expense
  equity
  cogs
}

model Account {
  id          Int         @id @default(autoincrement())
  code        String      @unique @db.VarChar(20)
  name        String      @db.VarChar(200)
  accountType AccountType @map("account_type")
  parentId    Int?        @map("parent_id")
  cityId      Int?        @map("city_id") // null = global account
  currencyCode String?    @map("currency_code") @db.VarChar(10)
  isSystem    Boolean     @default(false) @map("is_system") // system-created, cannot delete
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")

  parent          Account?       @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        Account[]      @relation("AccountHierarchy")
  city            City?          @relation(fields: [cityId], references: [id])
  journalEntries  JournalEntry[]
  agents          Agent[]

  @@index([accountType])
  @@index([cityId])
  @@map("accounts")
}

model JournalEntry {
  id            Int      @id @default(autoincrement())
  transactionId String   @map("transaction_id") @db.VarChar(50) // groups related entries: "SALE-123", "PAY-456"
  accountId     Int      @map("account_id")
  debit         Decimal  @default(0) @db.Decimal(15, 2)
  credit        Decimal  @default(0) @db.Decimal(15, 2)
  currencyCode  String   @map("currency_code") @db.VarChar(10)
  exchangeRate  Decimal? @map("exchange_rate") @db.Decimal(12, 4)
  description   String   @db.VarChar(500)
  entityType    String?  @map("entity_type") @db.VarChar(50) // sale, payment, expense, etc
  entityId      Int?     @map("entity_id")
  lotId         Int?     @map("lot_id")
  cityId        Int?     @map("city_id")
  entryDate     DateTime @map("entry_date") @db.Date
  createdBy     Int      @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  account  Account @relation(fields: [accountId], references: [id])

  @@index([transactionId])
  @@index([accountId])
  @@index([entityType, entityId])
  @@index([lotId])
  @@index([cityId])
  @@index([entryDate])
  @@map("journal_entries")
}

// ============================================================
// AGENTS (Customs agents, transport, etc. - running accounts)
// ============================================================

model Agent {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  agentType String   @map("agent_type") @db.VarChar(50) // customs, transport, freight, other
  cityId    Int?     @map("city_id") // linked to a city/port
  phone     String?  @db.VarChar(50)
  notes     String?  @db.Text
  accountId Int?     @map("account_id") // linked to their payable account
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city          City?          @relation(fields: [cityId], references: [id])
  account       Account?       @relation(fields: [accountId], references: [id])
  agentPayments AgentPayment[]
  lotCosts      LotCost[]

  @@index([agentType])
  @@index([cityId])
  @@map("agents")
}

model AgentPayment {
  id            Int      @id @default(autoincrement())
  agentId       Int      @map("agent_id")
  cityId        Int      @map("city_id")
  paymentDate   DateTime @map("payment_date") @db.Date
  amount        Decimal  @db.Decimal(15, 2)
  currencyCode  String   @map("currency_code") @db.VarChar(10)
  paymentMethod String   @map("payment_method") @db.VarChar(50)
  reference     String?  @db.VarChar(200)
  notes         String?  @db.Text
  createdBy     Int      @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  agent   Agent @relation(fields: [agentId], references: [id])
  city    City  @relation(fields: [cityId], references: [id])
  creator User  @relation("AgentPaymentCreatedBy", fields: [createdBy], references: [id])

  @@index([agentId])
  @@index([cityId])
  @@index([paymentDate])
  @@map("agent_payments")
}

// ============================================================
// INTER-CITY TRANSFERS
// ============================================================

model CityTransfer {
  id              Int      @id @default(autoincrement())
  fromCityId      Int      @map("from_city_id")
  toCityId        Int      @map("to_city_id")
  fromGodownId    Int      @map("from_godown_id")
  toGodownId      Int?     @map("to_godown_id") // null until receiver approves
  productId       Int      @map("product_id")
  lotId           Int      @map("lot_id")
  qty             Decimal  @db.Decimal(12, 2)
  status          String   @default("pending") @db.VarChar(20) // pending, approved, rejected
  notes           String?  @db.Text
  approvalNotes   String?  @map("approval_notes") @db.Text
  sentBy          Int      @map("sent_by")
  approvedBy      Int?     @map("approved_by")
  transferDate    DateTime @map("transfer_date") @db.Date
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  fromCity    City    @relation("TransferFromCity", fields: [fromCityId], references: [id])
  toCity      City    @relation("TransferToCity", fields: [toCityId], references: [id])
  fromGodown  Godown  @relation("TransferFromGodown", fields: [fromGodownId], references: [id])
  toGodown    Godown? @relation("TransferToGodown", fields: [toGodownId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
  lot         Lot     @relation(fields: [lotId], references: [id])
  sender      User    @relation("TransferSentBy", fields: [sentBy], references: [id])
  approver    User?   @relation("TransferApprovedBy", fields: [approvedBy], references: [id])

  @@index([fromCityId])
  @@index([toCityId])
  @@index([status])
  @@map("city_transfers")
}

// ============================================================
// SUPPLIER (Company you buy from)
// ============================================================

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  country   String?  @db.VarChar(100)
  contact   String?  @db.VarChar(200)
  notes     String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lotPurchases     LotPurchase[]
  supplierPayments SupplierPayment[]

  @@map("suppliers")
}

// ============================================================
// LOT PURCHASE (What you bought per lot - purchase price in USD)
// ============================================================

model LotPurchase {
  id              Int      @id @default(autoincrement())
  lotId           Int      @map("lot_id")
  supplierId      Int      @map("supplier_id")
  productId       Int      @map("product_id")
  qty             Decimal  @db.Decimal(12, 2)
  unitPriceUsd    Decimal  @map("unit_price_usd") @db.Decimal(12, 4)
  totalPriceUsd   Decimal  @map("total_price_usd") @db.Decimal(15, 2)
  exchangeRate    Decimal? @map("exchange_rate") @db.Decimal(12, 4) // USD to local at time of purchase
  notes           String?  @db.Text
  createdBy       Int      @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  lot      Lot      @relation(fields: [lotId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  creator  User     @relation("PurchaseCreatedBy", fields: [createdBy], references: [id])

  @@index([lotId])
  @@index([supplierId])
  @@map("lot_purchases")
}

// ============================================================
// LOT COSTS (All costs: customs, freight, transport, etc.)
// ============================================================

model LotCost {
  id           Int         @id @default(autoincrement())
  lotId        Int         @map("lot_id")
  costType     LotCostType @map("cost_type")
  description  String      @db.VarChar(500)
  amount       Decimal     @db.Decimal(15, 2)
  currencyCode String      @default("USD") @map("currency_code") @db.VarChar(10)
  exchangeRate Decimal?    @map("exchange_rate") @db.Decimal(12, 4)
  costDate     DateTime?   @map("cost_date") @db.Date
  agentId      Int?        @map("agent_id") // customs agent, transport company etc
  paidFromCash Boolean     @default(false) @map("paid_from_cash") // true = paid immediately, false = on credit to agent
  notes        String?     @db.Text
  createdBy    Int         @map("created_by")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  lot     Lot    @relation(fields: [lotId], references: [id])
  agent   Agent? @relation(fields: [agentId], references: [id])
  creator User   @relation("CostCreatedBy", fields: [createdBy], references: [id])

  @@index([lotId])
  @@index([costType])
  @@index([agentId])
  @@map("lot_costs")
}

// ============================================================
// SUPPLIER PAYMENTS (Payments to company - running account)
// ============================================================

model SupplierPayment {
  id            Int                   @id @default(autoincrement())
  supplierId    Int                   @map("supplier_id")
  lotId         Int?                  @map("lot_id") // optional - link to specific lot
  paymentDate   DateTime              @map("payment_date") @db.Date
  amountUsd     Decimal               @map("amount_usd") @db.Decimal(15, 2)
  exchangeRate  Decimal?              @map("exchange_rate") @db.Decimal(12, 4) // USD rate at payment time
  amountLocal   Decimal?              @map("amount_local") @db.Decimal(15, 2)  // equivalent in local currency
  paymentMethod SupplierPaymentMethod @map("payment_method")
  reference     String?               @db.VarChar(200) // bank ref, TT ref, etc
  notes         String?               @db.Text
  createdBy     Int                   @map("created_by")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])
  lot      Lot?     @relation(fields: [lotId], references: [id])
  creator  User     @relation("SupplierPaymentCreatedBy", fields: [createdBy], references: [id])

  @@index([supplierId])
  @@index([lotId])
  @@index([paymentDate])
  @@map("supplier_payments")
}

// ============================================================
// FILE ATTACHMENTS (Polymorphic)
// ============================================================

model Attachment {
  id         Int        @id @default(autoincrement())
  entityType EntityType @map("entity_type")
  entityId   Int        @map("entity_id")
  fileName   String     @map("file_name") @db.VarChar(500)
  filePath   String     @map("file_path") @db.VarChar(1000)
  fileType   String     @map("file_type") @db.VarChar(20)
  fileSize   Int        @map("file_size")
  uploadedBy Int        @map("uploaded_by")
  createdAt  DateTime   @default(now()) @map("created_at")

  uploader        User            @relation(fields: [uploadedBy], references: [id])
  // Polymorphic relations (optional, for direct navigation)
  sale            Sale?           @relation(fields: [saleEntityId], references: [id])
  saleEntityId    Int?            @map("sale_entity_id")
  payment         Payment?        @relation(fields: [paymentEntityId], references: [id])
  paymentEntityId Int?            @map("payment_entity_id")
  godownTransfer         GodownTransfer? @relation(fields: [godownTransferEntityId], references: [id])
  godownTransferEntityId Int?            @map("godown_transfer_entity_id")
  expense                Expense?        @relation(fields: [expenseEntityId], references: [id])
  expenseEntityId        Int?            @map("expense_entity_id")
  hajiTransfer           HajiTransfer?   @relation(fields: [hajiTransferEntityId], references: [id])
  hajiTransferEntityId   Int?            @map("haji_transfer_entity_id")

  @@index([entityType, entityId])
  @@map("attachments")
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id         Int         @id @default(autoincrement())
  userId     Int         @map("user_id")
  cityId     Int?        @map("city_id")
  entityType String      @map("entity_type") @db.VarChar(100)
  entityId   Int         @map("entity_id")
  action     AuditAction
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  ipAddress  String?     @map("ip_address") @db.VarChar(50)
  createdAt  DateTime    @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id])
  city City? @relation(fields: [cityId], references: [id])

  @@index([userId])
  @@index([cityId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// INVENTORY THRESHOLDS
// ============================================================

model InventoryThreshold {
  id        Int      @id @default(autoincrement())
  cityId    Int      @map("city_id")
  productId Int      @map("product_id")
  minQty    Decimal  @map("min_qty") @db.Decimal(12, 2)
  createdBy Int      @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city    City    @relation(fields: [cityId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  creator User    @relation(fields: [createdBy], references: [id])

  @@unique([cityId, productId])
  @@map("inventory_thresholds")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        Int      @id @default(autoincrement())
  cityId    Int?     @map("city_id")
  userId    Int?     @map("user_id")
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(200)
  message   String   @db.Text
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  city City? @relation(fields: [cityId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([cityId])
  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ============================================================
// CHAT
// ============================================================

model ChatThread {
  id        Int      @id @default(autoincrement())
  type      String   @db.VarChar(20) // "direct" | "group"
  name      String?  @db.VarChar(200) // for group threads (e.g. "General")
  cityId    Int?     @map("city_id")  // for direct threads: the city admin's city
  createdAt DateTime @default(now()) @map("created_at")

  city     City?         @relation(fields: [cityId], references: [id])
  messages ChatMessage[]

  @@index([type])
  @@index([cityId])
  @@map("chat_threads")
}

model ChatMessage {
  id          Int      @id @default(autoincrement())
  threadId    Int      @map("thread_id")
  senderId    Int      @map("sender_id")
  content     String   @db.Text
  messageType String   @default("text") @map("message_type") @db.VarChar(20)
  fileUrl     String?  @map("file_url") @db.VarChar(1000)
  fileName    String?  @map("file_name") @db.VarChar(500)
  fileSize    Int?     @map("file_size")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  thread ChatThread @relation(fields: [threadId], references: [id])
  sender User       @relation("MessagesSent", fields: [senderId], references: [id])

  @@index([threadId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isRead])
  @@map("chat_messages")
}
