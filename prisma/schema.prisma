enum ProductUnitOfMeasure {
  MT
  PCS
}

model Product {
  id                       Int                  @id @default(autoincrement())
  name                     String               @unique @db.VarChar(200)
  unitOfMeasure            ProductUnitOfMeasure @default(MT) @map("unit_of_measure")
