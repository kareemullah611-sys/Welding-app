model Sale {
  id                     Int        @id @default(autoincrement())
  cityId                 Int        @map("city_id")
  customerId             Int        @map("customer_id")
  lotId                  Int        @map("lot_id")
  godownId               Int        @map("godown_id")
  voucherNo              String     @map("voucher_no") @db.VarChar(10)
  saleDate               DateTime   @map("sale_date") @db.Date
  totalAmount            Decimal    @default(0) @map("total_amount") @db.Decimal(15, 2)
  currencyId             Int        @map("currency_id")
  fxSnapshotId           Int?       @map("fx_snapshot_id")
  fxOriginalCurrencyCode String?    @map("fx_original_currency_code") @db.VarChar(10)
  fxOriginalAmount       Decimal?   @map("fx_original_amount") @db.Decimal(15, 2)
  fxSelectedRate         Decimal?   @map("fx_selected_rate") @db.Decimal(18, 6)
  fxSelectedRateType     String?    @map("fx_selected_rate_type") @db.VarChar(40)
  fxProvider             String?    @map("fx_provider") @db.VarChar(120)
  fxProviderReference    String?    @map("fx_provider_reference") @db.VarChar(240)
  fxPkrEquivalent        Decimal?   @map("fx_pkr_equivalent") @db.Decimal(15, 2)
  fxConversionPathJson   Json?      @map("fx_conversion_path_json")
  notes                  String?    @db.Text
  status                 SaleStatus @default(active)
  isOpeningImport        Boolean    @default(false) @map("is_opening_import")
  stockShortFlag         Boolean    @default(false) @map("stock_short_flag")
  cancellationReason     String?    @map("cancellation_reason") @db.Text
  cancelledAt            DateTime?  @map("cancelled_at")
  cancelledBy            Int?       @map("cancelled_by")
  createdBy              Int        @map("created_by")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  city      City     @relation(fields: [cityId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  lot       Lot      @relation(fields: [lotId], references: [id])
  godown    Godown   @relation(fields: [godownId], references: [id])
  currency  Currency @relation(fields: [currencyId], references: [id])
  creator   User     @relation("SaleCreatedBy", fields: [createdBy], references: [id])
  canceller User?    @relation("SaleCancelledBy", fields: [cancelledBy], references: [id])

  items       SaleItem[]
  discounts   SaleDiscount[]
  attachments Attachment[]
  payments    Payment[]

  @@unique([cityId, voucherNo], name: "unique_sale_city_voucher")
  @@index([cityId])
  @@index([customerId])
  @@index([lotId])
  @@index([godownId])
  @@index([saleDate])
  @@index([status])
  @@index([cityId, voucherNo])
  @@index([cityId, saleDate])
  @@index([cityId, status, saleDate])
  @@map("sales")
}

model SaleItem {
  id                Int      @id @default(autoincrement())
  saleId            Int      @map("sale_id")
  lotId             Int      @map("lot_id")
  productId         Int      @map("product_id")
  qty               Decimal  @db.Decimal(12, 2)
  cartonQty         Decimal? @map("carton_qty") @db.Decimal(12, 2)
  ratePerCarton     Decimal  @map("rate_per_carton") @db.Decimal(12, 2)
  ratePerPieceLocal Decimal? @map("rate_per_piece_local") @db.Decimal(12, 4)
  ratePerPieceUsd   Decimal? @map("rate_per_piece_usd") @db.Decimal(12, 4)
  amount            Decimal  @db.Decimal(15, 2)
  amountUsd         Decimal? @map("amount_usd") @db.Decimal(15, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  lot     Lot     @relation(fields: [lotId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([lotId])
  @@index([productId])
  @@map("sale_items")
}

model SaleDiscount {
  id             Int      @id @default(autoincrement())
  saleId         Int      @map("sale_id")
  discountAmount Decimal  @map("discount_amount") @db.Decimal(15, 2)
  currencyId     Int      @map("currency_id")
  appliedToLotId Int      @map("applied_to_lot_id")
  notes          String?  @db.Text
  discountDate   DateTime @map("discount_date") @db.Date
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  sale         Sale     @relation(fields: [saleId], references: [id])
  currency     Currency @relation(fields: [currencyId], references: [id])
  appliedToLot Lot      @relation(fields: [appliedToLotId], references: [id])
  creator      User     @relation(fields: [createdBy], references: [id])

  @@index([saleId])
  @@index([appliedToLotId])
  @@map("sale_discounts")
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id                      Int                @id @default(autoincrement())
  cityId                  Int                @map("city_id")
  customerId              Int                @map("customer_id")
  lotId                   Int?               @map("lot_id")
  paymentDate             DateTime           @map("payment_date") @db.Date
  detail                  String             @db.VarChar(500)
  amount                  Decimal            @db.Decimal(15, 2)
  currencyId              Int                @map("currency_id")
  exchangeRate            Decimal?           @map("exchange_rate") @db.Decimal(12, 4)
  usdEquivalent           Decimal?           @map("usd_equivalent") @db.Decimal(15, 2)
  manualVoucherNo         String?            @map("manual_voucher_no") @db.VarChar(50)
  paymentMethod           PaymentMethod      @map("payment_method")
  destination             PaymentDestination
  notes                   String?            @db.Text
  status                  PaymentStatus      @default(active)
  cancellationReason      String?            @map("cancellation_reason") @db.Text
  cancelledAt             DateTime?          @map("cancelled_at")
  cancelledBy             Int?               @map("cancelled_by")
  // Cheque-specific fields (populated when paymentMethod = cheque)
  chequeNumber            String?            @map("cheque_number") @db.VarChar(50)
  chequeBank              String?            @map("cheque_bank") @db.VarChar(100)
  chequeDueDate           DateTime?          @map("cheque_due_date") @db.Date
  chequeStatus            ChequeStatus?      @map("cheque_status")
  bankDepositId           Int?               @map("bank_deposit_id")
  bankAccountId           Int?               @map("bank_account_id")
  superAdminBankAccountId Int?               @map("super_admin_bank_account_id")
  saleId                  Int?               @map("sale_id")
  createdBy               Int                @map("created_by")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  city                  City                   @relation(fields: [cityId], references: [id])
  customer              Customer               @relation(fields: [customerId], references: [id])
  lot                   Lot?                   @relation(fields: [lotId], references: [id])
  currency              Currency               @relation(fields: [currencyId], references: [id])
  creator               User                   @relation("PaymentCreatedBy", fields: [createdBy], references: [id])
  canceller             User?                  @relation("PaymentCancelledBy", fields: [cancelledBy], references: [id])
  bankDeposit           BankDeposit?           @relation("DepositCheques", fields: [bankDepositId], references: [id])
  bankAccount           BankAccount?           @relation("PaymentBankAccount", fields: [bankAccountId], references: [id])
  superAdminBankAccount SuperAdminBankAccount? @relation("PaymentSuperAdminBankAccount", fields: [superAdminBankAccountId], references: [id])
  sale                  Sale?                  @relation(fields: [saleId], references: [id])

  attachments                Attachment[]
  paymentLotTransfers        PaymentLotTransfer[]
  hajiTransferCheque         HajiTransfer?        @relation("HajiCheque")
  hajiTransferPayment        HajiTransfer?        @relation("HajiPayment")
  expenseCheques             Expense[]            @relation("ExpenseCheque")
  customerPaidExpense        Expense?             @relation("ExpenseCustomerPayment")
  withdrawalCheques          PersonalWithdrawal[] @relation("WithdrawalCheque")
  cityLiabilityChequeEntries CityLiabilityEntry[] @relation("CityLiabilityCheque")

  @@index([cityId])
  @@index([customerId])
  @@index([lotId])
  @@index([paymentDate])
  @@index([status])
  @@index([paymentMethod])
  @@index([bankAccountId])
  @@index([superAdminBankAccountId])
  @@index([saleId])
  @@index([cityId, paymentDate])
  @@index([cityId, status, paymentDate])
  @@index([cityId, destination, paymentDate])
  @@index([cityId, manualVoucherNo])
  @@map("payments")
}

model PaymentLotTransfer {
  id            Int      @id @default(autoincrement())
  paymentId     Int      @map("payment_id")
  fromLotId     Int      @map("from_lot_id")
  toLotId       Int      @map("to_lot_id")
  transferredBy Int      @map("transferred_by")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  payment     Payment @relation(fields: [paymentId], references: [id])
  fromLot     Lot     @relation("TransferFromLot", fields: [fromLotId], references: [id])
  toLot       Lot     @relation("TransferToLot", fields: [toLotId], references: [id])
  transferrer User    @relation(fields: [transferredBy], references: [id])

  @@index([paymentId])
  @@index([fromLotId])
  @@index([toLotId])
  @@map("payment_lot_transfers")
}

// ============================================================
// EXPENSES
// ============================================================

model Expense {
  id                Int             @id @default(autoincrement())
  cityId            Int             @map("city_id")
  lotId             Int?            @map("lot_id")
  expenseDate       DateTime        @map("expense_date") @db.Date
  amount            Decimal         @db.Decimal(15, 2)
  currencyId        Int             @map("currency_id")
  detail            String          @db.VarChar(500)
  notes             String?         @db.Text
  // Treasury: which pot paid for this expense
  paidFrom          ExpensePaidFrom @default(cash_office) @map("paid_from")
  bankAccountId     Int?            @map("bank_account_id")
  chequePaymentId   Int?            @map("cheque_payment_id")
  customerPaymentId Int?            @unique @map("customer_payment_id")
  createdBy         Int             @map("created_by")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at") // null = active; non-null = soft-deleted

  city            City         @relation(fields: [cityId], references: [id])
  lot             Lot?         @relation(fields: [lotId], references: [id])
  currency        Currency     @relation(fields: [currencyId], references: [id])
  creator         User         @relation(fields: [createdBy], references: [id])
  bankAccount     BankAccount? @relation(fields: [bankAccountId], references: [id])
  chequePayment   Payment?     @relation("ExpenseCheque", fields: [chequePaymentId], references: [id])
  customerPayment Payment?     @relation("ExpenseCustomerPayment", fields: [customerPaymentId], references: [id], onDelete: SetNull)
  attachments     Attachment[]

  @@index([cityId])
  @@index([lotId])
  @@index([expenseDate])
  @@index([deletedAt])
  @@map("expenses")
}

// ============================================================
// PERSONAL WITHDRAWALS
// ============================================================

model PersonalWithdrawal {
  id              Int                  @id @default(autoincrement())
  cityId          Int                  @map("city_id")
  withdrawalDate  DateTime             @map("withdrawal_date") @db.Date
  amount          Decimal              @db.Decimal(15, 2)
  currencyId      Int                  @map("currency_id")
  detail          String               @db.VarChar(500)
  withdrawnBy     String?              @map("withdrawn_by") @db.VarChar(100)
  notes           String?              @db.Text
  sourceType      WithdrawalSourceType @default(cash_office) @map("source_type")
  chequePaymentId Int?                 @map("cheque_payment_id")
  bankAccountId   Int?                 @map("bank_account_id")
  approvedBy      Int?                 @map("approved_by")
  approvedAt      DateTime?            @map("approved_at")
  hajiTransferId  Int?                 @unique @map("haji_transfer_id")
  createdBy       Int                  @map("created_by")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  city          City          @relation(fields: [cityId], references: [id])
  currency      Currency      @relation(fields: [currencyId], references: [id])
  creator       User          @relation("WithdrawalCreator", fields: [createdBy], references: [id])
  approver      User?         @relation("WithdrawalApprover", fields: [approvedBy], references: [id])
  hajiTransfer  HajiTransfer? @relation(fields: [hajiTransferId], references: [id])
  chequePayment Payment?      @relation("WithdrawalCheque", fields: [chequePaymentId], references: [id])
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id])

  @@index([cityId])
  @@index([bankAccountId])
  @@index([withdrawalDate])
  @@index([approvedBy])
  @@map("personal_withdrawals")
}

// ============================================================
// WITHDRAWEE NAMES (standalone reference, like customers)
// ============================================================

model WithdraweeName {
  id        Int      @id @default(autoincrement())
  cityId    Int      @map("city_id")
  name      String   @db.VarChar(100)
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city    City  @relation(fields: [cityId], references: [id])
  creator User? @relation("WithdraweeNameCreator", fields: [createdBy], references: [id])

  @@unique([cityId, name])
  @@index([cityId])
  @@map("withdrawee_names")
}

// ============================================================
// HAJI TRANSFERS
// ============================================================

model HajiTransfer {
  id                      Int                       @id @default(autoincrement())
  cityId                  Int                       @map("city_id")
  lotId                   Int?                      @map("lot_id")
  transferDate            DateTime                  @map("transfer_date") @db.Date
  amount                  Decimal                   @db.Decimal(15, 2)
  currencyId              Int                       @map("currency_id")
  detail                  String                    @db.VarChar(500)
  referenceNo             String?                   @map("reference_no") @db.VarChar(50)
  transferType            HajiTransferType          @map("transfer_type")
  transferredTo           String?                   @map("transferred_to") @db.VarChar(100)
  notes                   String?                   @db.Text
  // Treasury: where the money came from
  sourceType              HajiSourceType            @default(cash_office) @map("source_type")
  settlementDestination   HajiSettlementDestination @default(standard) @map("settlement_destination")
  intermediaryId          Int?                      @map("intermediary_id")
  superAdminCashAccountId Int?                      @map("super_admin_cash_account_id")
  superAdminBankAccountId Int?                      @map("super_admin_bank_account_id")
  bankAccountId           Int?                      @map("bank_account_id")
  chequePaymentId         Int?                      @unique @map("cheque_payment_id")
  paymentId               Int?                      @unique @map("payment_id")
  createdBy               Int                       @map("created_by")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  city                  City                   @relation(fields: [cityId], references: [id])
  lot                   Lot?                   @relation(fields: [lotId], references: [id])
  currency              Currency               @relation(fields: [currencyId], references: [id])
  creator               User                   @relation(fields: [createdBy], references: [id])
  bankAccount           BankAccount?           @relation(fields: [bankAccountId], references: [id])
  chequePayment         Payment?               @relation("HajiCheque", fields: [chequePaymentId], references: [id])
  payment               Payment?               @relation("HajiPayment", fields: [paymentId], references: [id])
  intermediary          Intermediary?          @relation(fields: [intermediaryId], references: [id])
  superAdminCashAccount SuperAdminBankAccount? @relation("HajiSuperAdminCash", fields: [superAdminCashAccountId], references: [id])
  superAdminBankAccount SuperAdminBankAccount? @relation("HajiSuperAdminBank", fields: [superAdminBankAccountId], references: [id])

  withdrawalSource PersonalWithdrawal?
  attachments      Attachment[]

  @@index([cityId])
  @@index([lotId])
  @@index([transferDate])
  @@index([transferredTo])
  @@index([intermediaryId])
  @@index([superAdminCashAccountId])
  @@index([superAdminBankAccountId])
  @@map("haji_transfers")
}

model LotSettlementOverflow {
  id             Int      @id @default(autoincrement())
  cityId         Int      @map("city_id")
  fromLotId      Int      @map("from_lot_id")
  toLotId        Int      @map("to_lot_id")
  overflowAmount Decimal  @map("overflow_amount") @db.Decimal(15, 2)
  currencyId     Int      @map("currency_id")
  notes          String?  @db.Text
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  city     City     @relation(fields: [cityId], references: [id])
  fromLot  Lot      @relation("OverflowFromLot", fields: [fromLotId], references: [id])
  toLot    Lot      @relation("OverflowToLot", fields: [toLotId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])
  creator  User     @relation(fields: [createdBy], references: [id])

  @@index([cityId])
  @@index([fromLotId])
  @@index([toLotId])
  @@map("lot_settlement_overflows")
}

// ============================================================
// LOT SETTLEMENT — UNRESOLVED OVERFLOWS
// Persisted record of overflows that had no ongoing lot to absorb them.
// Previously these were returned only in the HTTP response and lost on
// browser close. Fix C3: persist so they can be reconciled later.
// ============================================================
model LotSettlementUnresolvedOverflow {
  id              Int       @id @default(autoincrement())
  cityId          Int       @map("city_id")
  fromLotId       Int       @map("from_lot_id")
  overflowAmount  Decimal   @map("overflow_amount") @db.Decimal(15, 2)
  currencyId      Int       @map("currency_id")
  notes           String?   @db.Text
  createdBy       Int       @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  resolvedAt      DateTime? @map("resolved_at")
  resolvedBy      Int?      @map("resolved_by")
  resolutionNotes String?   @map("resolution_notes") @db.Text

  city     City     @relation(fields: [cityId], references: [id])
  fromLot  Lot      @relation("UnresolvedOverflowLot", fields: [fromLotId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])
  creator  User     @relation(fields: [createdBy], references: [id])

  @@index([cityId])
  @@index([fromLotId])
  @@index([resolvedAt])
  @@map("lot_settlement_unresolved_overflows")
}

// ============================================================
// TREASURY - Bank Accounts & Deposit Slips
// ============================================================

model BankAccount {
  id            Int      @id @default(autoincrement())
  cityId        Int      @map("city_id")
  bankName      String   @map("bank_name") @db.VarChar(100)
  accountNumber String?  @map("account_number") @db.VarChar(255)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  city                       City                       @relation(fields: [cityId], references: [id])
  deposits                   BankDeposit[]
  hajiTransfers              HajiTransfer[]
  expenses                   Expense[]
  lotCosts                   LotCost[]
  supplierPayments           SupplierPayment[]          @relation("SupplierPaymentBankAccount")
  shippingLinePayments       ShippingLinePayment[]      @relation("ShippingLinePaymentBankAccount")
  agentPayments              AgentPayment[]             @relation("AgentPaymentBankAccount")
  intermediaryDeposits       IntermediaryDeposit[]
  incomingPayments           Payment[]                  @relation("PaymentBankAccount")
  openingBankBalances        OpeningBankBalance[]
  personalWithdrawals        PersonalWithdrawal[]
  cityLiabilityEntries       CityLiabilityEntry[]
  superAdminLiabilityEntries SuperAdminLiabilityEntry[]

  @@index([cityId])
  @@map("bank_accounts")
}

model BankDeposit {
  id             Int      @id @default(autoincrement())
  cityId         Int      @map("city_id")
  bankAccountId  Int?     @map("bank_account_id")
  transferType   String   @default("cheque_to_bank") @map("transfer_type") @db.VarChar(30)
  transferPairId String?  @map("transfer_pair_id") @db.VarChar(50)
  depositDate    DateTime @map("deposit_date") @db.Date
  slipNumber     String?  @map("slip_number") @db.VarChar(50)
  cashAmount     Decimal  @default(0) @map("cash_amount") @db.Decimal(15, 2)
  currencyId     Int      @map("currency_id")
  notes          String?  @db.Text
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  city        City         @relation(fields: [cityId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  currency    Currency     @relation(fields: [currencyId], references: [id])
  cheques     Payment[]    @relation("DepositCheques")

  @@index([cityId])
  @@index([bankAccountId])
  @@index([depositDate])
  @@index([transferPairId])
  @@map("bank_deposits")
}

model SuperAdminBankAccount {
  id            Int                   @id @default(autoincrement())
  bankName      String                @map("bank_name") @db.VarChar(100)
  accountNumber String?               @map("account_number") @db.VarChar(255)
  currencyId    Int                   @map("currency_id")
  accountKind   SuperAdminAccountKind @default(bank) @map("account_kind")
  isActive      Boolean               @default(true) @map("is_active")
  createdBy     Int                   @map("created_by")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  currency                                Currency                                 @relation(fields: [currencyId], references: [id])
  creator                                 User                                     @relation(fields: [createdBy], references: [id])
  expenses                                SuperAdminPersonalExpense[]
  lotCosts                                LotCost[]
  incomingHajiPayments                    Payment[]                                @relation("PaymentSuperAdminBankAccount")
  intermediaryDeposits                    IntermediaryDeposit[]
  intermediaryDepositsFromCash            IntermediaryDeposit[]                    @relation("IntermediaryDepositSuperAdminCash")
  supplierPayments                        SupplierPayment[]                        @relation("SupplierPaymentSuperAdminBank")
  supplierPaymentsFromCash                SupplierPayment[]                        @relation("SupplierPaymentSuperAdminCash")
  agentPayments                           AgentPayment[]                           @relation("AgentPaymentSuperAdminBank")
  agentPaymentsFromCash                   AgentPayment[]                           @relation("AgentPaymentSuperAdminCash")
  shippingLinePayments                    ShippingLinePayment[]                    @relation("ShippingLinePaymentSuperAdminBank")
  shippingLinePaymentsFromCash            ShippingLinePayment[]                    @relation("ShippingLinePaymentSuperAdminCash")
  hajiTransferReceipts                    HajiTransfer[]                           @relation("HajiSuperAdminCash")
  hajiTransferBankReceipts                HajiTransfer[]                           @relation("HajiSuperAdminBank")
  hajiCashReceipts                        HajiCashReceipt[]
  investmentParticipantSettlementPayments InvestmentParticipantSettlementPayment[]
  openingBalances                         OpeningSuperAdminAccountBalance[]
  liabilityBankEntries                    SuperAdminLiabilityEntry[]               @relation("SuperAdminLiabilityBankSource")
  liabilityCashEntries                    SuperAdminLiabilityEntry[]               @relation("SuperAdminLiabilityCashSource")
  outgoingTransfers                       SuperAdminAccountTransfer[]              @relation("SuperAdminTransferSourceAccount")
  incomingTransfers                       SuperAdminAccountTransfer[]              @relation("SuperAdminTransferDestinationAccount")

  @@index([currencyId])
  @@index([createdBy])
  @@map("super_admin_bank_accounts")
}

model SuperAdminPersonalExpense {
  id             Int       @id @default(autoincrement())
  bankAccountId  Int       @map("bank_account_id")
  expenseDate    DateTime  @map("expense_date") @db.Date
  amount         Decimal   @db.Decimal(15, 2)
  detail         String    @db.VarChar(500)
  notes          String?   @db.Text
  journalVersion Int       @default(1) @map("journal_version")
  createdBy      Int       @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  bankAccount SuperAdminBankAccount @relation(fields: [bankAccountId], references: [id])
  creator     User                  @relation(fields: [createdBy], references: [id])

  @@index([bankAccountId])
  @@index([expenseDate])
  @@index([deletedAt])
  @@map("super_admin_personal_expenses")
}

// ============================================================
// ACCOUNTING - Chart of Accounts & Journal Entries
// ============================================================

enum AccountType {
  asset
  liability
  revenue
  expense
  equity
  cogs
}

enum FinancialYearStatus {
  open
  closed
}

model FinancialYear {
  id           Int                 @id @default(autoincrement())
  name         String              @db.VarChar(100)
  startDate    DateTime            @map("start_date") @db.Date
  endDate      DateTime            @map("end_date") @db.Date
  status       FinancialYearStatus @default(open)
  closeReason  String?             @map("close_reason") @db.Text
  closedBy     Int?                @map("closed_by")
  closedAt     DateTime?           @map("closed_at")
  reopenReason String?             @map("reopen_reason") @db.Text
  reopenedBy   Int?                @map("reopened_by")
  reopenedAt   DateTime?           @map("reopened_at")
  createdBy    Int                 @map("created_by")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@unique([startDate, endDate])
  @@index([status])
  @@map("financial_years")
}

model Account {
  id           Int         @id @default(autoincrement())
  code         String      @unique @db.VarChar(20)
  name         String      @db.VarChar(200)
  accountType  AccountType @map("account_type")
  parentId     Int?        @map("parent_id")
  cityId       Int?        @map("city_id") // null = global account
  currencyCode String?     @map("currency_code") @db.VarChar(10)
  isSystem     Boolean     @default(false) @map("is_system") // system-created, cannot delete
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")

  parent                            Account?                     @relation("AccountHierarchy", fields: [parentId], references: [id])
  children                          Account[]                    @relation("AccountHierarchy")
  city                              City?                        @relation(fields: [cityId], references: [id])
  journalEntries                    JournalEntry[]
  agents                            Agent[]
  superAdminLiabilityAccounts       SuperAdminLiabilityAccount[] @relation("SuperAdminLiabilityControlAccount")
  superAdminLiabilityCounterEntries SuperAdminLiabilityEntry[]   @relation("SuperAdminLiabilityCounterAccount")

  @@index([accountType])
  @@index([cityId])
  @@map("accounts")
}

model JournalEntry {
  id            Int      @id @default(autoincrement())
  transactionId String   @map("transaction_id") @db.VarChar(50) // groups related entries: "SALE-123", "PAY-456"
  lineNumber    Int      @map("line_number")
  accountId     Int      @map("account_id")
  debit         Decimal  @default(0) @db.Decimal(15, 2)
  credit        Decimal  @default(0) @db.Decimal(15, 2)
  currencyCode  String   @map("currency_code") @db.VarChar(10)
  exchangeRate  Decimal? @map("exchange_rate") @db.Decimal(12, 4)
  description   String   @db.VarChar(500)
  entityType    String?  @map("entity_type") @db.VarChar(50) // sale, payment, expense, etc
  entityId      Int?     @map("entity_id")
  lotId         Int?     @map("lot_id")
  cityId        Int?     @map("city_id")
  entryDate     DateTime @map("entry_date") @db.Date
  createdBy     Int      @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])

  @@unique([transactionId, lineNumber], map: "journal_entries_transaction_line_key")
  @@index([transactionId])
  @@index([accountId])
  @@index([entityType, entityId])
  @@index([lotId])
  @@index([cityId])
  @@index([entryDate])
  @@map("journal_entries")
}

// ============================================================
// AGENTS (Customs agents, transport, etc. - running accounts)
// ============================================================

model Agent {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(200)
  agentType AgentType @map("agent_type") // customs, transport, freight, other
  cityId    Int?      @map("city_id") // linked to a city/port
  phone     String?   @db.VarChar(50)
  notes     String?   @db.Text
  accountId Int?      @map("account_id") // linked to their payable account
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  city               City?              @relation(fields: [cityId], references: [id])
  account            Account?           @relation(fields: [accountId], references: [id])
  agentPayments      AgentPayment[]
  lotCosts           LotCost[]
  openingLiabilities OpeningLiability[]

  @@index([agentType])
  @@index([cityId])
  @@map("agents")
}

model AgentPayment {
  id                      Int                @id @default(autoincrement())
  agentId                 Int                @map("agent_id")
  cityId                  Int                @map("city_id")
  paymentDate             DateTime           @map("payment_date") @db.Date
  amount                  Decimal            @db.Decimal(15, 2)
  currencyCode            String             @map("currency_code") @db.VarChar(10)
  paymentMethod           AgentPaymentMethod @map("payment_method")
  bankAccountId           Int?               @map("bank_account_id") // if paid from bank
  superAdminBankAccountId Int?               @map("super_admin_bank_account_id")
  intermediaryId          Int?               @map("intermediary_id") // if paid through intermediary
  superAdminCashAccountId Int?               @map("super_admin_cash_account_id")
  reference               String?            @db.VarChar(200)
  notes                   String?            @db.Text
  journalVersion          Int                @default(1) @map("journal_version")
  createdBy               Int                @map("created_by")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  deletedAt               DateTime?          @map("deleted_at")
  deletedBy               Int?               @map("deleted_by")

  agent                 Agent                  @relation(fields: [agentId], references: [id])
  city                  City                   @relation(fields: [cityId], references: [id])
  bankAccount           BankAccount?           @relation("AgentPaymentBankAccount", fields: [bankAccountId], references: [id])
  superAdminBankAccount SuperAdminBankAccount? @relation("AgentPaymentSuperAdminBank", fields: [superAdminBankAccountId], references: [id])
  intermediary          Intermediary?          @relation("AgentPaymentIntermediary", fields: [intermediaryId], references: [id])
  superAdminCashAccount SuperAdminBankAccount? @relation("AgentPaymentSuperAdminCash", fields: [superAdminCashAccountId], references: [id])
  creator               User                   @relation("AgentPaymentCreatedBy", fields: [createdBy], references: [id])

  @@index([agentId])
  @@index([cityId])
  @@index([paymentDate])
  @@index([bankAccountId])
  @@index([superAdminBankAccountId])
  @@index([intermediaryId])
  @@index([superAdminCashAccountId])
  @@index([deletedAt])
  @@map("agent_payments")
}

// ============================================================
// INTER-CITY TRANSFERS
// ============================================================

model CityTransfer {
  id            Int                @id @default(autoincrement())
  fromCityId    Int                @map("from_city_id")
  toCityId      Int                @map("to_city_id")
  fromGodownId  Int                @map("from_godown_id")
  toGodownId    Int?               @map("to_godown_id") // null until receiver approves
  productId     Int                @map("product_id")
  lotId         Int                @map("lot_id")
  qty           Decimal            @db.Decimal(12, 2)
  status        CityTransferStatus @default(pending) // pending, approved, rejected
  notes         String?            @db.Text
  approvalNotes String?            @map("approval_notes") @db.Text
  sentBy        Int                @map("sent_by")
  approvedBy    Int?               @map("approved_by")
  transferDate  DateTime           @map("transfer_date") @db.Date
  approvedAt    DateTime?          @map("approved_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  fromCity   City    @relation("TransferFromCity", fields: [fromCityId], references: [id])
  toCity     City    @relation("TransferToCity", fields: [toCityId], references: [id])
  fromGodown Godown  @relation("TransferFromGodown", fields: [fromGodownId], references: [id])
  toGodown   Godown? @relation("TransferToGodown", fields: [toGodownId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
  lot        Lot     @relation(fields: [lotId], references: [id])
  sender     User    @relation("TransferSentBy", fields: [sentBy], references: [id])
  approver   User?   @relation("TransferApprovedBy", fields: [approvedBy], references: [id])

  @@index([fromCityId])
  @@index([toCityId])
  @@index([status])
  @@map("city_transfers")
}

// ============================================================
// SUPPLIER (Company you buy from)
// ============================================================

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(200)
  country   String?  @db.VarChar(100)
  contact   String?  @db.VarChar(200)
  notes     String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lotPurchases       LotPurchase[]
  supplierPayments   SupplierPayment[]
  lotCosts           LotCost[]
  openingLiabilities OpeningLiability[]

  @@map("suppliers")
}

// ============================================================
// LOT PURCHASE (What you bought per lot - purchase price in USD)
// ============================================================

model LotPurchase {
  id                      Int       @id @default(autoincrement())
  lotId                   Int       @map("lot_id")
  supplierId              Int       @map("supplier_id")
  productId               Int       @map("product_id")
  qty                     Decimal   @db.Decimal(12, 3) // quantity in MT (metric tons)
  weightPerCartonKg       Decimal?  @map("weight_per_carton_kg") @db.Decimal(10, 3) // kg per carton e.g. 20
  unitPriceUsd            Decimal   @map("unit_price_usd") @db.Decimal(12, 4) // USD per MT
  totalPriceUsd           Decimal   @map("total_price_usd") @db.Decimal(15, 2) // qty × unitPriceUsd
  exchangeRate            Decimal?  @map("exchange_rate") @db.Decimal(12, 4) // kept for legacy; rate is on SupplierPayment
  carryingRatePkr         Decimal?  @map("carrying_rate_pkr") @db.Decimal(12, 6)
  carryingAmountPkr       Decimal?  @map("carrying_amount_pkr") @db.Decimal(15, 2)
  recognitionDate         DateTime? @map("recognition_date") @db.Date
  recognitionRateMetadata Json?     @map("recognition_rate_metadata")
  journalVersion          Int       @default(1) @map("journal_version")
  notes                   String?   @db.Text
  createdBy               Int       @map("created_by")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  lot      Lot      @relation(fields: [lotId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  creator  User     @relation("PurchaseCreatedBy", fields: [createdBy], references: [id])

  @@index([lotId])
  @@index([supplierId])
  @@map("lot_purchases")
}

// ============================================================
// LOT COSTS (All costs: customs, freight, transport, etc.)
// ============================================================

model LotCost {
  id                      Int         @id @default(autoincrement())
  lotId                   Int         @map("lot_id")
  costType                LotCostType @map("cost_type")
  description             String      @db.VarChar(500)
  amount                  Decimal     @db.Decimal(15, 2)
  currencyCode            String      @default("USD") @map("currency_code") @db.VarChar(10)
  exchangeRate            Decimal?    @map("exchange_rate") @db.Decimal(12, 4)
  costDate                DateTime?   @map("cost_date") @db.Date
  supplierId              Int?        @map("supplier_id") // liability charged to supplier
  agentId                 Int?        @map("agent_id") // customs / transport agent
  shippingLineId          Int?        @map("shipping_line_id") // for freight costs
  bankAccountId           Int?        @map("bank_account_id") // for direct bank payment
  superAdminBankAccountId Int?        @map("super_admin_bank_account_id") // super admin bank debit source
  intermediaryId          Int?        @map("intermediary_id") // for intermediary settlement
  paidFromCash            Boolean     @default(false) @map("paid_from_cash")
  journalVersion          Int         @default(1) @map("journal_version")
  notes                   String?     @db.Text
  createdBy               Int         @map("created_by")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  lot                   Lot                    @relation(fields: [lotId], references: [id])
  supplier              Supplier?              @relation(fields: [supplierId], references: [id])
  agent                 Agent?                 @relation(fields: [agentId], references: [id])
  shippingLine          ShippingLine?          @relation(fields: [shippingLineId], references: [id])
  bankAccount           BankAccount?           @relation(fields: [bankAccountId], references: [id])
  superAdminBankAccount SuperAdminBankAccount? @relation(fields: [superAdminBankAccountId], references: [id])
  intermediary          Intermediary?          @relation(fields: [intermediaryId], references: [id])
  creator               User                   @relation("CostCreatedBy", fields: [createdBy], references: [id])

  @@index([lotId])
  @@index([costType])
  @@index([supplierId])
  @@index([agentId])
  @@index([bankAccountId])
  @@index([superAdminBankAccountId])
  @@index([intermediaryId])
  @@map("lot_costs")
}

// ============================================================
// SUPPLIER PAYMENTS (Payments to company - running account)
// ============================================================

model SupplierPayment {
  id                      Int                   @id @default(autoincrement())
  supplierId              Int                   @map("supplier_id")
  lotId                   Int?                  @map("lot_id") // optional - link to specific lot
  bankAccountId           Int?                  @map("bank_account_id") // legacy city bank
  superAdminBankAccountId Int?                  @map("super_admin_bank_account_id")
  superAdminCashAccountId Int?                  @map("super_admin_cash_account_id")
  intermediaryId          Int?                  @map("intermediary_id") // paid through hawala intermediary
  paymentDate             DateTime              @map("payment_date") @db.Date
  amountUsd               Decimal               @map("amount_usd") @db.Decimal(15, 2)
  exchangeRate            Decimal?              @map("exchange_rate") @db.Decimal(12, 4) // USD rate at payment time
  amountLocal             Decimal?              @map("amount_local") @db.Decimal(15, 2) // equivalent in local currency
  carryingRatePkr         Decimal?              @map("carrying_rate_pkr") @db.Decimal(12, 6)
  carryingAmountPkr       Decimal?              @map("carrying_amount_pkr") @db.Decimal(15, 2)
  realizedFxPkr           Decimal?              @map("realized_fx_pkr") @db.Decimal(15, 2) // positive = gain, negative = loss
  fxPoolDate              DateTime?             @map("fx_pool_date") @db.Date
  journalVersion          Int                   @default(1) @map("journal_version")
  paymentMethod           SupplierPaymentMethod @map("payment_method")
  reference               String?               @db.VarChar(200) // bank ref, TT ref, etc
  notes                   String?               @db.Text
  createdBy               Int                   @map("created_by")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  deletedAt               DateTime?             @map("deleted_at")
  deletedBy               Int?                  @map("deleted_by")

  supplier                  Supplier                   @relation(fields: [supplierId], references: [id])
  lot                       Lot?                       @relation(fields: [lotId], references: [id])
  bankAccount               BankAccount?               @relation("SupplierPaymentBankAccount", fields: [bankAccountId], references: [id])
  superAdminBankAccount     SuperAdminBankAccount?     @relation("SupplierPaymentSuperAdminBank", fields: [superAdminBankAccountId], references: [id])
  superAdminCashAccount     SuperAdminBankAccount?     @relation("SupplierPaymentSuperAdminCash", fields: [superAdminCashAccountId], references: [id])
  intermediary              Intermediary?              @relation(fields: [intermediaryId], references: [id])
  creator                   User                       @relation("SupplierPaymentCreatedBy", fields: [createdBy], references: [id])
  intermediaryUsdCostUsages IntermediaryUsdCostUsage[]

  @@index([supplierId])
  @@index([lotId])
  @@index([bankAccountId])
  @@index([superAdminBankAccountId])
  @@index([superAdminCashAccountId])
  @@index([intermediaryId])
  @@index([paymentDate])
  @@index([deletedAt])
  @@map("supplier_payments")
}

// ============================================================
// SHIPPING LINE (Freight carrier — separate running USD account)
// ============================================================

model ShippingLine {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(200)
  contact   String?  @db.VarChar(200)
  notes     String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lotCosts           LotCost[]
  payments           ShippingLinePayment[]
  openingLiabilities OpeningLiability[]

  @@map("shipping_lines")
}

model ShippingLinePayment {
  id                      Int       @id @default(autoincrement())
  shippingLineId          Int       @map("shipping_line_id")
  lotId                   Int?      @map("lot_id")
  bankAccountId           Int?      @map("bank_account_id") // which bank the payment was sent from
  superAdminBankAccountId Int?      @map("super_admin_bank_account_id")
  paymentDate             DateTime  @map("payment_date") @db.Date
  amountUsd               Decimal   @map("amount_usd") @db.Decimal(15, 2)
  exchangeRate            Decimal?  @map("exchange_rate") @db.Decimal(12, 4)
  amountPkr               Decimal?  @map("amount_pkr") @db.Decimal(15, 2)
  carryingRatePkr         Decimal?  @map("carrying_rate_pkr") @db.Decimal(12, 6)
  carryingAmountPkr       Decimal?  @map("carrying_amount_pkr") @db.Decimal(15, 2)
  realizedFxPkr           Decimal?  @map("realized_fx_pkr") @db.Decimal(15, 2) // positive = gain, negative = loss
  fxPoolDate              DateTime? @map("fx_pool_date") @db.Date
  journalVersion          Int       @default(1) @map("journal_version")
  reference               String?   @db.VarChar(200)
  notes                   String?   @db.Text
  createdBy               Int       @map("created_by")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")
  deletedBy               Int?      @map("deleted_by")

  intermediaryId          Int? @map("intermediary_id") // paid through intermediary (alternative to bank)
  superAdminCashAccountId Int? @map("super_admin_cash_account_id")

  shippingLine              ShippingLine               @relation(fields: [shippingLineId], references: [id])
  lot                       Lot?                       @relation(fields: [lotId], references: [id])
  bankAccount               BankAccount?               @relation("ShippingLinePaymentBankAccount", fields: [bankAccountId], references: [id])
  superAdminBankAccount     SuperAdminBankAccount?     @relation("ShippingLinePaymentSuperAdminBank", fields: [superAdminBankAccountId], references: [id])
  intermediary              Intermediary?              @relation("ShippingLinePaymentIntermediary", fields: [intermediaryId], references: [id])
  superAdminCashAccount     SuperAdminBankAccount?     @relation("ShippingLinePaymentSuperAdminCash", fields: [superAdminCashAccountId], references: [id])
  creator                   User                       @relation("ShippingLinePaymentCreatedBy", fields: [createdBy], references: [id])
  intermediaryUsdCostUsages IntermediaryUsdCostUsage[]

  @@index([shippingLineId])
  @@index([lotId])
  @@index([bankAccountId])
  @@index([superAdminBankAccountId])
  @@index([intermediaryId])
  @@index([superAdminCashAccountId])
  @@index([deletedAt])
  @@map("shipping_line_payments")
}

// ============================================================
// FILE ATTACHMENTS (Polymorphic)
// ============================================================

model Attachment {
  id         Int        @id @default(autoincrement())
  entityType EntityType @map("entity_type")
  entityId   Int        @map("entity_id")
  fileName   String     @map("file_name") @db.VarChar(500)
  filePath   String     @map("file_path") @db.VarChar(1000)
  fileType   String     @map("file_type") @db.VarChar(20)
  fileSize   Int        @map("file_size")
  uploadedBy Int        @map("uploaded_by")
  createdAt  DateTime   @default(now()) @map("created_at")

  uploader               User            @relation(fields: [uploadedBy], references: [id])
  // Polymorphic relations (optional, for direct navigation)
  sale                   Sale?           @relation(fields: [saleEntityId], references: [id])
  saleEntityId           Int?            @map("sale_entity_id")
  payment                Payment?        @relation(fields: [paymentEntityId], references: [id])
  paymentEntityId        Int?            @map("payment_entity_id")
  godownTransfer         GodownTransfer? @relation(fields: [godownTransferEntityId], references: [id])
  godownTransferEntityId Int?            @map("godown_transfer_entity_id")
  expense                Expense?        @relation(fields: [expenseEntityId], references: [id])
  expenseEntityId        Int?            @map("expense_entity_id")
  hajiTransfer           HajiTransfer?   @relation(fields: [hajiTransferEntityId], references: [id])
  hajiTransferEntityId   Int?            @map("haji_transfer_entity_id")

  @@index([entityType, entityId])
  @@map("attachments")
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id         Int         @id @default(autoincrement())
  userId     Int         @map("user_id")
  cityId     Int?        @map("city_id")
  entityType String      @map("entity_type") @db.VarChar(100)
  entityId   Int         @map("entity_id")
  action     AuditAction
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  ipAddress  String?     @map("ip_address") @db.VarChar(50)
  createdAt  DateTime    @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id])
  city City? @relation(fields: [cityId], references: [id])

  @@index([userId])
  @@index([cityId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SyncRequest {
  id         Int      @id @default(autoincrement())
  cityId     Int      @map("city_id")
  module     String   @db.VarChar(80)
  requestId  String   @map("request_id") @db.VarChar(120)
  deviceId   String?  @map("device_id") @db.VarChar(120)
  entityType String?  @map("entity_type") @db.VarChar(80)
  entityId   Int?     @map("entity_id")
  createdBy  Int?     @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  creator User? @relation("SyncRequestCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([cityId, module, requestId], name: "unique_sync_request_per_city_module")
  @@index([cityId])
  @@index([createdAt])
  @@map("sync_requests")
}

// ============================================================
// INVENTORY THRESHOLDS
// ============================================================

model InventoryThreshold {
  id        Int      @id @default(autoincrement())
  cityId    Int      @map("city_id")
  productId Int      @map("product_id")
  minQty    Decimal  @map("min_qty") @db.Decimal(12, 2)
  createdBy Int      @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city    City    @relation(fields: [cityId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  creator User    @relation(fields: [createdBy], references: [id])

  @@unique([cityId, productId])
  @@map("inventory_thresholds")
}

// ============================================================
// INVESTOR ACCOUNTS
// ============================================================

enum InvestorProfitType {
  fixed_rate // profit = capital × fixed_rate%
  profit_share // profit = total_business_profit × share%
}

enum InvestmentParticipantType {
  manager
  investor
}

enum InvestmentCapitalEventType {
  opening
  capital_contribution
  capital_withdrawal
  profit_reinvestment
  full_exit
}

enum ProfitAttributionPeriodStatus {
  preview
  finalized
  reversed
  voided
}

enum InvestorAttributionLedgerCategory {
  investor_profit
  investor_capital_loss
  manager_own_capital
  manager_profit_share
  manager_residual
}

enum InvestorAttributionLedgerEntryType {
  finalization
  reversal
}

enum InvestmentParticipantActionType {
  profit_withdrawal
  capital_withdrawal
  mixed_withdrawal
  profit_reinvestment
  full_exit
  reversal
}

enum InvestmentParticipantActionStatus {
  active
  reversed
}

enum InvestmentParticipantActionLedgerCategory {
  finalized_profit_withdrawal
  capital_withdrawal
  profit_reinvestment
  full_exit_profit
  full_exit_capital
  reversal
}

enum InvestmentParticipantSettlementStatus {
  unsettled
  partially_settled
  settled
  reversed
}

model Investor {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(200)
  relationship String?  @db.VarChar(100)
  phone        String?  @db.VarChar(50)
  notes        String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    Int      @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  creator      User                    @relation(fields: [createdBy], references: [id])
  accounts     InvestorAccount[]
  participants InvestmentParticipant[]

  @@map("investors")
}

model InvestorAccount {
  id                 Int                @id @default(autoincrement())
  investorId         Int                @map("investor_id")
  currencyId         Int                @map("currency_id")
  profitType         InvestorProfitType @default(fixed_rate) @map("profit_type")
  fixedRatePercent   Decimal?           @map("fixed_rate_percent") @db.Decimal(6, 3) // e.g. 12.000 = 12%
  profitSharePercent Decimal?           @map("profit_share_percent") @db.Decimal(6, 3) // e.g. 5.000 = 5%
  startDate          DateTime           @map("start_date") @db.Date
  isActive           Boolean            @default(true) @map("is_active")
  createdBy          Int                @map("created_by")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  investor          Investor             @relation(fields: [investorId], references: [id])
  currency          Currency             @relation(fields: [currencyId], references: [id])
  creator           User                 @relation(fields: [createdBy], references: [id])
  deposits          InvestorDeposit[]
  withdrawals       InvestorWithdrawal[]
  profitAllocations ProfitAllocation[]

  @@map("investor_accounts")
}

model InvestorDeposit {
  id          Int      @id @default(autoincrement())
  accountId   Int      @map("account_id")
  amount      Decimal  @db.Decimal(15, 2)
  depositDate DateTime @map("deposit_date") @db.Date
  notes       String?  @db.Text
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  account InvestorAccount @relation(fields: [accountId], references: [id])
  creator User            @relation(fields: [createdBy], references: [id])

  @@map("investor_deposits")
}

model InvestorWithdrawal {
  id             Int      @id @default(autoincrement())
  accountId      Int      @map("account_id")
  amount         Decimal  @db.Decimal(15, 2)
  withdrawalDate DateTime @map("withdrawal_date") @db.Date
  notes          String?  @db.Text
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  account InvestorAccount @relation(fields: [accountId], references: [id])
  creator User            @relation(fields: [createdBy], references: [id])

  @@map("investor_withdrawals")
}

model InvestmentParticipant {
  id         Int                       @id @default(autoincrement())
  investorId Int?                      @map("investor_id")
  name       String                    @db.VarChar(200)
  type       InvestmentParticipantType @default(investor)
  isActive   Boolean                   @default(true) @map("is_active")
  exitedAt   DateTime?                 @map("exited_at") @db.Date
  notes      String?                   @db.Text
  createdBy  Int?                      @map("created_by")
  createdAt  DateTime                  @default(now()) @map("created_at")
  updatedAt  DateTime                  @updatedAt @map("updated_at")

  investor                       Investor?                                @relation(fields: [investorId], references: [id], onDelete: SetNull)
  capitalEvents                  InvestmentCapitalEvent[]
  profitShareEvents              InvestmentProfitShareEvent[]
  attributionLines               ProfitAttributionLine[]
  residualAttributions           InvestorResidualAttribution[]            @relation("ResidualOriginalParticipant")
  managerResidualAttributions    InvestorResidualAttribution[]            @relation("ResidualManagerParticipant")
  ledgerEntries                  InvestorAttributionLedgerEntry[]
  participantActions             InvestmentParticipantAction[]
  participantActionLedgerEntries InvestmentParticipantActionLedgerEntry[]
  participantSettlements         InvestmentParticipantSettlement[]
  participantSettlementPayments  InvestmentParticipantSettlementPayment[]

  @@index([investorId])
  @@index([type])
  @@index([isActive])
  @@map("investment_participants")
}

model InvestmentCapitalEvent {
  id                         Int                        @id @default(autoincrement())
  participantId              Int                        @map("participant_id")
  eventType                  InvestmentCapitalEventType @map("event_type")
  amountPkr                  Decimal                    @map("amount_pkr") @db.Decimal(15, 2)
  effectiveDate              DateTime                   @map("effective_date") @db.Date
  investorProfitSharePercent Decimal?                   @map("investor_profit_share_percent") @db.Decimal(9, 6)
  managerProfitSharePercent  Decimal?                   @map("manager_profit_share_percent") @db.Decimal(9, 6)
  sourceType                 String?                    @map("source_type") @db.VarChar(80)
  sourceId                   Int?                       @map("source_id")
  reason                     String?                    @db.Text
  createdBy                  Int?                       @map("created_by")
  createdAt                  DateTime                   @default(now()) @map("created_at")

  participant       InvestmentParticipant        @relation(fields: [participantId], references: [id], onDelete: Restrict)
  participantAction InvestmentParticipantAction?

  @@index([participantId, effectiveDate], map: "investment_capital_events_participant_date_idx")
  @@index([effectiveDate], map: "investment_capital_events_effective_date_idx")
  @@map("investment_capital_events")
}

model InvestmentProfitShareEvent {
  id                         Int      @id @default(autoincrement())
  participantId              Int      @map("participant_id")
  effectiveDate              DateTime @map("effective_date") @db.Date
  investorProfitSharePercent Decimal  @map("investor_profit_share_percent") @db.Decimal(9, 6)
  managerProfitSharePercent  Decimal  @map("manager_profit_share_percent") @db.Decimal(9, 6)
  reference                  String?  @db.VarChar(120)
  remarks                    String?  @db.Text
  createdBy                  Int?     @map("created_by")
  createdAt                  DateTime @default(now()) @map("created_at")

  participant InvestmentParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@index([participantId, effectiveDate], map: "investment_profit_share_events_participant_date_idx")
  @@index([effectiveDate], map: "investment_profit_share_events_effective_date_idx")
  @@map("investment_profit_share_events")
}

model ProfitAttributionPeriod {
  id                          Int                           @id @default(autoincrement())
  periodStart                 DateTime                      @map("period_start") @db.Date
  periodEnd                   DateTime                      @map("period_end") @db.Date
  status                      ProfitAttributionPeriodStatus @default(preview)
  businessProfitPkr           Decimal                       @map("business_profit_pkr") @db.Decimal(15, 2)
  totalAttributedPkr          Decimal                       @map("total_attributed_pkr") @db.Decimal(15, 2)
  reconciliationDifferencePkr Decimal                       @map("reconciliation_difference_pkr") @db.Decimal(15, 2)
  reconciliationStatus        String                        @map("reconciliation_status") @db.VarChar(30)
  finalizationDisabledReasons Json?                         @map("finalization_disabled_reasons")
  sourceReportReference       String?                       @map("source_report_reference") @db.VarChar(200)
  snapshotJson                Json?                         @map("snapshot_json")
  postingSimulationJson       Json?                         @map("posting_simulation_json")
  finalizedBy                 Int?                          @map("finalized_by")
  finalizedAt                 DateTime?                     @map("finalized_at")
  reversedBy                  Int?                          @map("reversed_by")
  reversedAt                  DateTime?                     @map("reversed_at")
  reversalReason              String?                       @map("reversal_reason") @db.Text
  reversalOfPeriodId          Int?                          @map("reversal_of_period_id")
  reconciliationReference     String?                       @map("reconciliation_reference") @db.VarChar(240)
  idempotencyKey              String?                       @unique @map("idempotency_key") @db.VarChar(240)
  createdBy                   Int?                          @map("created_by")
  createdAt                   DateTime                      @default(now()) @map("created_at")
  updatedAt                   DateTime                      @updatedAt @map("updated_at")

  lines                ProfitAttributionLine[]
  residualAttributions InvestorResidualAttribution[]
  ledgerEntries        InvestorAttributionLedgerEntry[]
  reversalOf           ProfitAttributionPeriod?         @relation("ProfitAttributionReversal", fields: [reversalOfPeriodId], references: [id], onDelete: Restrict)
  reversals            ProfitAttributionPeriod[]        @relation("ProfitAttributionReversal")

  @@index([periodStart, periodEnd], map: "profit_attribution_periods_period_idx")
  @@index([status], map: "profit_attribution_periods_status_idx")
  @@index([reversalOfPeriodId], map: "profit_attribution_periods_reversal_of_idx")
  @@map("profit_attribution_periods")
}

model ProfitAttributionLine {
  id                         Int      @id @default(autoincrement())
  periodId                   Int      @map("period_id")
  participantId              Int      @map("participant_id")
  segmentStart               DateTime @map("segment_start") @db.Date
  segmentEnd                 DateTime @map("segment_end") @db.Date
  capitalPkr                 Decimal  @map("capital_pkr") @db.Decimal(15, 2)
  capitalPercent             Decimal  @map("capital_percent") @db.Decimal(9, 6)
  poolProfitPkr              Decimal  @map("pool_profit_pkr") @db.Decimal(15, 2)
  attributablePkr            Decimal  @map("attributable_pkr") @db.Decimal(15, 2)
  investorProfitSharePercent Decimal  @map("investor_profit_share_percent") @db.Decimal(9, 6)
  managerProfitSharePercent  Decimal  @map("manager_profit_share_percent") @db.Decimal(9, 6)
  investorEntitlementPkr     Decimal  @map("investor_entitlement_pkr") @db.Decimal(15, 2)
  managerOwnCapitalProfitPkr Decimal  @map("manager_own_capital_profit_pkr") @db.Decimal(15, 2)
  managerSharePkr            Decimal  @map("manager_share_pkr") @db.Decimal(15, 2)
  allocatedLossPkr           Decimal  @map("allocated_loss_pkr") @db.Decimal(15, 2)
  totalAttributedPkr         Decimal  @map("total_attributed_pkr") @db.Decimal(15, 2)
  createdAt                  DateTime @default(now()) @map("created_at")

  period      ProfitAttributionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  participant InvestmentParticipant   @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@index([periodId], map: "profit_attribution_lines_period_idx")
  @@index([participantId], map: "profit_attribution_lines_participant_idx")
  @@map("profit_attribution_lines")
}

model InvestorResidualAttribution {
  id                      Int      @id @default(autoincrement())
  periodId                Int      @map("period_id")
  originalParticipantId   Int      @map("original_participant_id")
  managerParticipantId    Int      @map("manager_participant_id")
  sourceType              String   @map("source_type") @db.VarChar(80)
  sourceId                Int?     @map("source_id")
  originalCapitalPercent  Decimal  @map("original_capital_percent") @db.Decimal(9, 6)
  originalAttributablePkr Decimal  @map("original_attributable_pkr") @db.Decimal(15, 2)
  managerAssumptionPkr    Decimal  @map("manager_assumption_pkr") @db.Decimal(15, 2)
  postingDate             DateTime @map("posting_date") @db.Date
  notes                   String?  @db.Text
  createdBy               Int?     @map("created_by")
  createdAt               DateTime @default(now()) @map("created_at")

  period              ProfitAttributionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  originalParticipant InvestmentParticipant   @relation("ResidualOriginalParticipant", fields: [originalParticipantId], references: [id], onDelete: Restrict)
  managerParticipant  InvestmentParticipant   @relation("ResidualManagerParticipant", fields: [managerParticipantId], references: [id], onDelete: Restrict)

  @@index([periodId], map: "investor_residual_attributions_period_idx")
  @@index([originalParticipantId], map: "investor_residual_attributions_original_idx")
  @@map("investor_residual_attributions")
}

model InvestorAttributionLedgerEntry {
  id                      Int                                @id @default(autoincrement())
  periodId                Int                                @map("period_id")
  participantId           Int                                @map("participant_id")
  category                InvestorAttributionLedgerCategory
  entryType               InvestorAttributionLedgerEntryType @map("entry_type")
  amountPkr               Decimal                            @map("amount_pkr") @db.Decimal(15, 2)
  debitAccount            String                             @map("debit_account") @db.VarChar(160)
  creditAccount           String                             @map("credit_account") @db.VarChar(160)
  sourcePool              String?                            @map("source_pool") @db.VarChar(500)
  sourceAttributionLine   String?                            @map("source_attribution_line") @db.VarChar(200)
  postingType             String                             @map("posting_type") @db.VarChar(120)
  reconciliationReference String                             @map("reconciliation_reference") @db.VarChar(240)
  reversalOfEntryId       Int?                               @map("reversal_of_entry_id")
  createdBy               Int?                               @map("created_by")
  createdAt               DateTime                           @default(now()) @map("created_at")

  period      ProfitAttributionPeriod          @relation(fields: [periodId], references: [id], onDelete: Restrict)
  participant InvestmentParticipant            @relation(fields: [participantId], references: [id], onDelete: Restrict)
  reversalOf  InvestorAttributionLedgerEntry?  @relation("InvestorAttributionLedgerReversal", fields: [reversalOfEntryId], references: [id], onDelete: Restrict)
  reversals   InvestorAttributionLedgerEntry[] @relation("InvestorAttributionLedgerReversal")

  @@unique([periodId, reconciliationReference, entryType], map: "investor_attr_ledger_period_ref_type_key")
  @@index([periodId], map: "investor_attr_ledger_period_idx")
  @@index([participantId], map: "investor_attr_ledger_participant_idx")
  @@index([category], map: "investor_attr_ledger_category_idx")
  @@index([reversalOfEntryId], map: "investor_attr_ledger_reversal_idx")
  @@map("investor_attribution_ledger_entries")
}

model InvestmentParticipantAction {
  id                         Int                                   @id @default(autoincrement())
  participantId              Int                                   @map("participant_id")
  actionType                 InvestmentParticipantActionType       @map("action_type")
  status                     InvestmentParticipantActionStatus     @default(active)
  profitAmountPkr            Decimal                               @default(0) @map("profit_amount_pkr") @db.Decimal(15, 2)
  capitalAmountPkr           Decimal                               @default(0) @map("capital_amount_pkr") @db.Decimal(15, 2)
  totalAmountPkr             Decimal                               @default(0) @map("total_amount_pkr") @db.Decimal(15, 2)
  settledAmountPkr           Decimal                               @default(0) @map("settled_amount_pkr") @db.Decimal(15, 2)
  remainingSettlementPkr     Decimal                               @default(0) @map("remaining_settlement_pkr") @db.Decimal(15, 2)
  settlementStatus           InvestmentParticipantSettlementStatus @default(unsettled) @map("settlement_status")
  effectiveDate              DateTime                              @map("effective_date") @db.Date
  oldCapitalPkr              Decimal                               @map("old_capital_pkr") @db.Decimal(15, 2)
  newCapitalPkr              Decimal                               @map("new_capital_pkr") @db.Decimal(15, 2)
  oldAvailableProfitPkr      Decimal                               @map("old_available_profit_pkr") @db.Decimal(15, 2)
  newAvailableProfitPkr      Decimal                               @map("new_available_profit_pkr") @db.Decimal(15, 2)
  finalizedProfitSourcesJson Json?                                 @map("finalized_profit_sources_json")
  confirmationReference      String                                @map("confirmation_reference") @db.VarChar(240)
  idempotencyKey             String                                @unique @map("idempotency_key") @db.VarChar(240)
  remarks                    String?                               @db.Text
  reversalOfActionId         Int?                                  @map("reversal_of_action_id")
  reversalReason             String?                               @map("reversal_reason") @db.Text
  capitalEventId             Int?                                  @unique @map("capital_event_id")
  createdBy                  Int?                                  @map("created_by")
  createdAt                  DateTime                              @default(now()) @map("created_at")

  participant        InvestmentParticipant                    @relation(fields: [participantId], references: [id], onDelete: Restrict)
  capitalEvent       InvestmentCapitalEvent?                  @relation(fields: [capitalEventId], references: [id], onDelete: Restrict)
  reversalOf         InvestmentParticipantAction?             @relation("InvestmentParticipantActionReversal", fields: [reversalOfActionId], references: [id], onDelete: Restrict)
  reversals          InvestmentParticipantAction[]            @relation("InvestmentParticipantActionReversal")
  ledgerEntries      InvestmentParticipantActionLedgerEntry[]
  settlements        InvestmentParticipantSettlement[]
  settlementPayments InvestmentParticipantSettlementPayment[]

  @@index([participantId, effectiveDate], map: "investment_participant_actions_participant_date_idx")
  @@index([actionType], map: "investment_participant_actions_type_idx")
  @@index([status], map: "investment_participant_actions_status_idx")
  @@index([settlementStatus], map: "investment_participant_actions_settlement_status_idx")
  @@index([reversalOfActionId], map: "investment_participant_actions_reversal_of_idx")
  @@map("investment_participant_actions")
}

model InvestmentParticipantActionLedgerEntry {
  id                      Int                                       @id @default(autoincrement())
  actionId                Int                                       @map("action_id")
  participantId           Int                                       @map("participant_id")
  category                InvestmentParticipantActionLedgerCategory
  amountPkr               Decimal                                   @map("amount_pkr") @db.Decimal(15, 2)
  debitAccount            String                                    @map("debit_account") @db.VarChar(160)
  creditAccount           String                                    @map("credit_account") @db.VarChar(160)
  sourceFinalizationIds   Json?                                     @map("source_finalization_ids")
  reconciliationReference String                                    @map("reconciliation_reference") @db.VarChar(240)
  reversalOfEntryId       Int?                                      @map("reversal_of_entry_id")
  createdBy               Int?                                      @map("created_by")
  createdAt               DateTime                                  @default(now()) @map("created_at")

  action      InvestmentParticipantAction              @relation(fields: [actionId], references: [id], onDelete: Restrict)
  participant InvestmentParticipant                    @relation(fields: [participantId], references: [id], onDelete: Restrict)
  reversalOf  InvestmentParticipantActionLedgerEntry?  @relation("InvestmentParticipantActionLedgerReversal", fields: [reversalOfEntryId], references: [id], onDelete: Restrict)
  reversals   InvestmentParticipantActionLedgerEntry[] @relation("InvestmentParticipantActionLedgerReversal")

  @@unique([actionId, reconciliationReference], map: "investment_participant_action_ledger_action_ref_key")
  @@index([participantId], map: "investment_participant_action_ledger_participant_idx")
  @@index([category], map: "investment_participant_action_ledger_category_idx")
  @@index([reversalOfEntryId], map: "investment_participant_action_ledger_reversal_idx")
  @@map("investment_participant_action_ledger_entries")
}

model InvestmentParticipantSettlement {
  id                     Int                                   @id @default(autoincrement())
  actionId               Int                                   @map("action_id")
  participantId          Int                                   @map("participant_id")
  status                 InvestmentParticipantSettlementStatus @default(unsettled)
  currencyId             Int                                   @map("currency_id")
  settlementAmount       Decimal                               @map("settlement_amount") @db.Decimal(15, 2)
  pkrEquivalent          Decimal                               @map("pkr_equivalent") @db.Decimal(15, 2)
  profitComponentPkr     Decimal                               @default(0) @map("profit_component_pkr") @db.Decimal(15, 2)
  capitalComponentPkr    Decimal                               @default(0) @map("capital_component_pkr") @db.Decimal(15, 2)
  exchangeRate           Decimal?                              @map("exchange_rate") @db.Decimal(15, 6)
  fxSnapshotId           Int?                                  @map("fx_snapshot_id")
  rateSource             String?                               @map("rate_source") @db.VarChar(120)
  rateDate               DateTime?                             @map("rate_date") @db.Date
  selectedRateType       String?                               @map("selected_rate_type") @db.VarChar(40)
  providerReference      String?                               @map("provider_reference") @db.VarChar(240)
  conversionPathJson     Json?                                 @map("conversion_path_json")
  paymentDate            DateTime                              @map("payment_date") @db.Date
  paymentReference       String                                @map("payment_reference") @db.VarChar(240)
  paymentMethod          String                                @map("payment_method") @db.VarChar(80)
  bankCashAccount        String?                               @map("bank_cash_account") @db.VarChar(200)
  idempotencyKey         String                                @unique @map("idempotency_key") @db.VarChar(240)
  reversalOfSettlementId Int?                                  @map("reversal_of_settlement_id")
  reversalReason         String?                               @map("reversal_reason") @db.Text
  createdBy              Int?                                  @map("created_by")
  createdAt              DateTime                              @default(now()) @map("created_at")

  action      InvestmentParticipantAction              @relation(fields: [actionId], references: [id], onDelete: Restrict)
  participant InvestmentParticipant                    @relation(fields: [participantId], references: [id], onDelete: Restrict)
  currency    Currency                                 @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  reversalOf  InvestmentParticipantSettlement?         @relation("InvestmentParticipantSettlementReversal", fields: [reversalOfSettlementId], references: [id], onDelete: Restrict)
  reversals   InvestmentParticipantSettlement[]        @relation("InvestmentParticipantSettlementReversal")
  payments    InvestmentParticipantSettlementPayment[]

  @@index([actionId], map: "investment_participant_settlements_action_idx")
  @@index([participantId], map: "investment_participant_settlements_participant_idx")
  @@index([status], map: "investment_participant_settlements_status_idx")
  @@index([paymentDate], map: "investment_participant_settlements_payment_date_idx")
  @@index([reversalOfSettlementId], map: "investment_participant_settlements_reversal_idx")
  @@map("investment_participant_settlements")
}

model InvestmentParticipantSettlementPayment {
  id                      Int                                   @id @default(autoincrement())
  settlementId            Int                                   @map("settlement_id")
  actionId                Int                                   @map("action_id")
  participantId           Int                                   @map("participant_id")
  status                  InvestmentParticipantSettlementStatus @default(settled)
  superAdminBankAccountId Int                                   @map("super_admin_bank_account_id")
  currencyId              Int                                   @map("currency_id")
  paymentAmount           Decimal                               @map("payment_amount") @db.Decimal(15, 2)
  pkrEquivalent           Decimal                               @map("pkr_equivalent") @db.Decimal(15, 2)
  exchangeRate            Decimal?                              @map("exchange_rate") @db.Decimal(15, 6)
  rateSource              String?                               @map("rate_source") @db.VarChar(120)
  rateDate                DateTime?                             @map("rate_date") @db.Date
  selectedRateType        String?                               @map("selected_rate_type") @db.VarChar(40)
  providerReference       String?                               @map("provider_reference") @db.VarChar(240)
  conversionPathJson      Json?                                 @map("conversion_path_json")
  paymentDate             DateTime                              @map("payment_date") @db.Date
  paymentReference        String                                @map("payment_reference") @db.VarChar(240)
  paymentMethod           String                                @map("payment_method") @db.VarChar(80)
  remarks                 String?                               @db.Text
  idempotencyKey          String                                @unique @map("idempotency_key") @db.VarChar(240)
  journalTransactionId    String?                               @map("journal_transaction_id") @db.VarChar(80)
  reversalOfPaymentId     Int?                                  @map("reversal_of_payment_id")
  reversalReason          String?                               @map("reversal_reason") @db.Text
  createdBy               Int?                                  @map("created_by")
  createdAt               DateTime                              @default(now()) @map("created_at")

  settlement        InvestmentParticipantSettlement          @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  action            InvestmentParticipantAction              @relation(fields: [actionId], references: [id], onDelete: Restrict)
  participant       InvestmentParticipant                    @relation(fields: [participantId], references: [id], onDelete: Restrict)
  superAdminAccount SuperAdminBankAccount                    @relation(fields: [superAdminBankAccountId], references: [id], onDelete: Restrict)
  currency          Currency                                 @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  reversalOf        InvestmentParticipantSettlementPayment?  @relation("InvestmentParticipantSettlementPaymentReversal", fields: [reversalOfPaymentId], references: [id], onDelete: Restrict)
  reversals         InvestmentParticipantSettlementPayment[] @relation("InvestmentParticipantSettlementPaymentReversal")

  @@index([settlementId], map: "investment_participant_settlement_payments_settlement_idx")
  @@index([actionId], map: "investment_participant_settlement_payments_action_idx")
  @@index([participantId], map: "investment_participant_settlement_payments_participant_idx")
  @@index([superAdminBankAccountId], map: "investment_participant_settlement_payments_account_idx")
  @@index([status], map: "investment_participant_settlement_payments_status_idx")
  @@index([paymentDate], map: "investment_participant_settlement_payments_payment_date_idx")
  @@index([journalTransactionId], map: "investment_participant_settlement_payments_journal_txn_idx")
  @@index([reversalOfPaymentId], map: "investment_participant_settlement_payments_reversal_idx")
  @@map("investment_participant_settlement_payments")
}

// ============================================================
// HAWALA / INTERMEDIARY PARTY
// ============================================================

model Intermediary {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(200)
  notes     String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  deposits                   IntermediaryDeposit[]
  exchanges                  IntermediaryExchange[]
  lotCosts                   LotCost[]
  supplierPayments           SupplierPayment[]
  shippingLinePayments       ShippingLinePayment[]      @relation("ShippingLinePaymentIntermediary")
  agentPayments              AgentPayment[]             @relation("AgentPaymentIntermediary")
  openingLiabilities         OpeningLiability[]
  hajiTransfers              HajiTransfer[]
  hajiCashReceipts           HajiCashReceipt[]
  superAdminLiabilityEntries SuperAdminLiabilityEntry[]
  usdCostLayers              IntermediaryUsdCostLayer[]
  usdCostUsages              IntermediaryUsdCostUsage[]

  @@map("intermediaries")
}

model IntermediaryDeposit {
  id                      Int                    @id @default(autoincrement())
  intermediaryId          Int                    @map("intermediary_id")
  depositDate             DateTime               @map("deposit_date") @db.Date
  amount                  Decimal                @db.Decimal(15, 2)
  currencyId              Int                    @map("currency_id")
  sourceType              IntermediarySourceType @map("source_type")
  cityId                  Int?                   @map("city_id") // if city_cash
  bankAccountId           Int?                   @map("bank_account_id") // if bank_account
  superAdminBankAccountId Int?                   @map("super_admin_bank_account_id") // if super_admin_bank_account
  superAdminCashAccountId Int?                   @map("super_admin_cash_account_id") // if super_admin_cash
  notes                   String?                @db.Text
  journalVersion          Int                    @default(1) @map("journal_version")
  createdBy               Int                    @map("created_by")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  deletedAt               DateTime?              @map("deleted_at")
  deletedBy               Int?                   @map("deleted_by")

  intermediary          Intermediary           @relation(fields: [intermediaryId], references: [id])
  currency              Currency               @relation(fields: [currencyId], references: [id])
  city                  City?                  @relation(fields: [cityId], references: [id])
  bankAccount           BankAccount?           @relation(fields: [bankAccountId], references: [id])
  superAdminBankAccount SuperAdminBankAccount? @relation(fields: [superAdminBankAccountId], references: [id])
