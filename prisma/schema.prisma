generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  super_admin
  city_admin
}

enum LotStatus {
  ongoing
  completed
}

enum SaleStatus {
  active
  cancelled
  marked_short
}

enum PaymentStatus {
  active
  cancelled
}

enum PaymentMethod {
  cash
  cheque
  bank_transfer
  online
}

enum PaymentDestination {
  haji
  our_account
}

enum HajiTransferType {
  direct
  from_in_hand
}

enum ChequeStatus {
  in_hand
  deposited_to_bank
  sent_to_haji
  used_for_expense
  used_for_withdrawal
  bounced
}

enum HajiSourceType {
  cash_office
  cheque
  bank_transfer
}

enum HajiSettlementDestination {
  standard
  intermediary
  super_admin_cash
}

enum SuperAdminAccountKind {
  bank
  cash
}

enum IntermediarySourceType {
  city_cash
  bank_account
  super_admin_bank_account
  super_admin_cash
}

enum ExpensePaidFrom {
  cash_office
  bank_account
  cheque
}

enum WithdrawalSourceType {
  cash_office
  cheque
}

enum SupplierPaymentMethod {
  bank_transfer
  tt
  lc
  cash
  other
}

enum LotCostType {
  purchase_price
  freight
  customs_duty
  port_charges
  transport
  loading_unloading
  insurance
  customs_agent
  clearing_agent
  other
}

enum OpeningLiabilityType {
  supplier
  shipping_line
  agent
  intermediary
}

enum EntityType {
  sale
  payment
  godown_transfer
  expense
  haji_transfer
}

enum AuditAction {
  create
  update
  delete
  cancel
  restore
  hard_delete
}

// ============================================================
// CORE TABLES
// ============================================================

model Country {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")

  cities City[]
  lots   Lot[]

  @@map("countries")
}

model Currency {
  id     Int    @id @default(autoincrement())
  code   String @unique @db.VarChar(10)
  name   String @db.VarChar(100)
  symbol String @db.VarChar(10)

  cityCurrencies         CityCurrency[]
  sales                  Sale[]
  payments               Payment[]
  expenses               Expense[]
  personalWithdrawals    PersonalWithdrawal[]
  hajiTransfers          HajiTransfer[]
  saleDiscounts          SaleDiscount[]
  lotSettlementOverflows LotSettlementOverflow[]
  bankDeposits           BankDeposit[]
  investorAccounts       InvestorAccount[]
  intermediaryDeposits   IntermediaryDeposit[]
  intermediaryExchangeFrom IntermediaryExchange[] @relation("IntermediaryExchangeFromCurrency")
  intermediaryExchangeTo   IntermediaryExchange[] @relation("IntermediaryExchangeToCurrency")
  intermediaryExchangeBase IntermediaryExchange[] @relation("IntermediaryExchangeBaseCurrency")
  intermediaryExchangeQuote IntermediaryExchange[] @relation("IntermediaryExchangeQuoteCurrency")
  superAdminBankAccounts SuperAdminBankAccount[]
  openingCashes         OpeningCash[]
  openingCustomerBalances OpeningCustomerBalance[]
  openingLiabilities    OpeningLiability[]
  openingBankBalances   OpeningBankBalance[]
  openingCheques        OpeningCheque[]
  openingHajiBalances   OpeningHajiBalance[]
  hajiCashReceipts      HajiCashReceipt[]

  @@map("currencies")
}

model City {
  id        Int      @id @default(autoincrement())
  countryId Int      @map("country_id")
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  country            Country              @relation(fields: [countryId], references: [id])
  cityCurrencies     CityCurrency[]
  users              User[]
  godowns            Godown[]
  customers          Customer[]
  sales              Sale[]
  payments           Payment[]
  expenses           Expense[]
  personalWithdrawals PersonalWithdrawal[]
  hajiTransfers      HajiTransfer[]
  lotCityDistributions LotCityDistribution[]
  inventoryThresholds InventoryThreshold[]
  voucherSequence    VoucherSequence?
  auditLogs          AuditLog[]
  lotSettlementOverflows LotSettlementOverflow[]
  cityTransfersFrom  CityTransfer[] @relation("TransferFromCity")
  cityTransfersTo    CityTransfer[] @relation("TransferToCity")
  accounts           Account[]
  agentPayments      AgentPayment[]
  agents             Agent[]
  godownAccessFrom   CityGodownPermission[] @relation("GodownAccessFrom")
  godownAccessTo     CityGodownPermission[] @relation("GodownAccessTo")
  bankAccounts           BankAccount[]
  bankDeposits           BankDeposit[]
  intermediaryDeposits   IntermediaryDeposit[]
  openingCashes          OpeningCash[]
  openingStocks          OpeningStock[]
  openingBankBalances    OpeningBankBalance[]
  openingCheques         OpeningCheque[]
  openingHajiBalances    OpeningHajiBalance[]

  @@unique([countryId, name])
  @@index([countryId])
  @@map("cities")
}

model CityGodownPermission {
  id          Int      @id @default(autoincrement())
  fromCityId  Int      @map("from_city_id")
  toCityId    Int      @map("to_city_id")
  createdAt   DateTime @default(now()) @map("created_at")

  fromCity City @relation("GodownAccessFrom", fields: [fromCityId], references: [id], onDelete: Cascade)
  toCity   City @relation("GodownAccessTo",   fields: [toCityId],   references: [id], onDelete: Cascade)

  @@unique([fromCityId, toCityId], name: "unique_city_godown_perm")
  @@index([fromCityId])
  @@map("city_godown_permissions")
}

model CityCurrency {
  id         Int @id @default(autoincrement())
  cityId     Int @map("city_id")
  currencyId Int @map("currency_id")

  city     City     @relation(fields: [cityId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  @@unique([cityId, currencyId])
  @@map("city_currencies")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(200)
  role         UserRole
  cityId       Int?     @map("city_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  city               City?               @relation(fields: [cityId], references: [id])
  lotsCreated        Lot[]               @relation("LotCreatedBy")
  lotsCompleted      Lot[]               @relation("LotCompletedBy")
  salesCreated       Sale[]              @relation("SaleCreatedBy")
  salesCancelled     Sale[]              @relation("SaleCancelledBy")
  paymentsCreated    Payment[]           @relation("PaymentCreatedBy")
  paymentsCancelled  Payment[]           @relation("PaymentCancelledBy")
  expensesCreated       Expense[]
  personalWithdrawals   PersonalWithdrawal[]  @relation("WithdrawalCreator")
  withdrawalsApproved   PersonalWithdrawal[]  @relation("WithdrawalApprover")
  hajiTransfers         HajiTransfer[]
  godownTransfers    GodownTransfer[]
  attachments        Attachment[]
  auditLogs          AuditLog[]
  inventoryThresholds InventoryThreshold[]
  saleDiscounts      SaleDiscount[]
  paymentLotTransfers PaymentLotTransfer[]
  lotSettlementOverflows LotSettlementOverflow[]
  purchasesCreated   LotPurchase[]  @relation("PurchaseCreatedBy")
  openingCashes      OpeningCash[]
  openingCustomerBalances OpeningCustomerBalance[]
  openingStocks      OpeningStock[]
  openingLiabilities OpeningLiability[]
  openingBankBalances OpeningBankBalance[]
  openingCheques     OpeningCheque[]
  openingHajiBalances OpeningHajiBalance[]
  costsCreated       LotCost[]      @relation("CostCreatedBy")
  supplierPaymentsCreated    SupplierPayment[]    @relation("SupplierPaymentCreatedBy")
  shippingLinePaymentsCreated ShippingLinePayment[] @relation("ShippingLinePaymentCreatedBy")
  cityTransfersSent      CityTransfer[] @relation("TransferSentBy")
  cityTransfersApproved  CityTransfer[] @relation("TransferApprovedBy")
  agentPaymentsCreated   AgentPayment[] @relation("AgentPaymentCreatedBy")
  sessions               UserSession[]
  investorsCreated       Investor[]
  investorAccountsCreated InvestorAccount[]
  investorDepositsCreated InvestorDeposit[]
  investorWithdrawalsCreated InvestorWithdrawal[]
  profitAllocationsCreated     ProfitAllocation[]
  intermediaryDepositsCreated  IntermediaryDeposit[]
  hajiCashReceiptsCreated      HajiCashReceipt[]
  intermediaryExchangesCreated IntermediaryExchange[] @relation("IntermediaryExchangeCreatedBy")
  intermediaryExchangesDeleted IntermediaryExchange[] @relation("IntermediaryExchangeDeletedBy")
  superAdminBankAccountsCreated SuperAdminBankAccount[]
  superAdminPersonalExpensesCreated SuperAdminPersonalExpense[]

  @@index([cityId])
  @@index([role])
  @@map("users")
}

// ============================================================
// USER SESSIONS
// ============================================================

model UserSession {
  id           String   @id @default(cuid())
  userId       Int      @map("user_id")
  tokenHash    String   @map("token_hash") @db.VarChar(255)
  deviceInfo   String?  @map("device_info") @db.VarChar(500)
  ipAddress    String?  @map("ip_address") @db.VarChar(50)
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  expiresAt    DateTime @map("expires_at")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@index([isActive])
  @@map("user_sessions")
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lotProducts          LotProduct[]
  lotCityDistributions LotCityDistribution[]
  lotCityGodownAllocations LotCityGodownAllocation[] @relation("ProductGodownAlloc")
  saleItems            SaleItem[]
  godownTransfers      GodownTransfer[]
  inventoryThresholds  InventoryThreshold[]
  lotPurchases         LotPurchase[]
  cityTransfers        CityTransfer[]
  openingStocks        OpeningStock[]

  @@map("products")
}

// ============================================================
// GODOWNS
// ============================================================

model Godown {
  id        Int      @id @default(autoincrement())
  cityId    Int      @map("city_id")
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city                     City                      @relation(fields: [cityId], references: [id])
  sales                    Sale[]
  godownTransfersFrom      GodownTransfer[]           @relation("TransferFrom")
  godownTransfersTo        GodownTransfer[]           @relation("TransferTo")
  lotCityGodownAllocations LotCityGodownAllocation[]
  cityTransfersFrom  CityTransfer[] @relation("TransferFromGodown")
  cityTransfersTo    CityTransfer[] @relation("TransferToGodown")
  openingStocks      OpeningStock[]

  @@unique([cityId, name])
  @@index([cityId])
  @@map("godowns")
}

model GodownTransfer {
  id            Int      @id @default(autoincrement())
  fromGodownId  Int      @map("from_godown_id")
  toGodownId    Int      @map("to_godown_id")
  productId     Int      @map("product_id")
  lotId         Int      @map("lot_id")
  qty           Decimal  @db.Decimal(12, 2)
  transferDate  DateTime @map("transfer_date") @db.Date
  notes         String?  @db.Text
  createdBy     Int      @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  fromGodown Godown  @relation("TransferFrom", fields: [fromGodownId], references: [id])
  toGodown   Godown  @relation("TransferTo", fields: [toGodownId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
  lot        Lot     @relation(fields: [lotId], references: [id])
  creator    User    @relation(fields: [createdBy], references: [id])

  attachments Attachment[]

  @@index([fromGodownId])
  @@index([toGodownId])
  @@index([lotId])
  @@map("godown_transfers")
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id        Int      @id @default(autoincrement())
  cityId    Int      @map("city_id")
  name      String   @db.VarChar(200)
  phone     String?  @db.VarChar(50)
  address   String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city     City      @relation(fields: [cityId], references: [id])
  sales    Sale[]
  payments Payment[]
  openingBalances OpeningCustomerBalance[]

  @@index([cityId])
  @@index([name])
  @@map("customers")
}

model OpeningCash {
  id          Int      @id @default(autoincrement())
  cityId      Int      @map("city_id")
  currencyId  Int      @map("currency_id")
  amount      Decimal  @db.Decimal(15, 2)
  openingDate DateTime @map("opening_date") @db.Date
  notes       String?  @db.Text
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  currency  Currency @relation(fields: [currencyId], references: [id])
  creator   User     @relation(fields: [createdBy], references: [id])

  @@unique([cityId, currencyId], name: "unique_opening_cash_city_currency")
  @@index([cityId])
  @@index([openingDate])
  @@map("opening_cashes")
}

model OpeningHajiBalance {
  id          Int      @id @default(autoincrement())
  cityId      Int      @map("city_id")
  currencyId  Int      @map("currency_id")
  amount      Decimal  @db.Decimal(15, 2)
  openingDate DateTime @map("opening_date") @db.Date
  notes       String?  @db.Text
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  city     City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id])
  creator  User     @relation(fields: [createdBy], references: [id])

  @@unique([cityId, currencyId], name: "unique_opening_haji_city_currency")
  @@index([cityId])
  @@index([openingDate])
  @@map("opening_haji_balances")
}

model OpeningCustomerBalance {
  id          Int      @id @default(autoincrement())
  customerId  Int      @map("customer_id")
  currencyId  Int      @map("currency_id")
  amount      Decimal  @db.Decimal(15, 2)
  openingDate DateTime @map("opening_date") @db.Date
  notes       String?  @db.Text
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id])
  creator  User     @relation(fields: [createdBy], references: [id])

  @@unique([customerId, currencyId], name: "unique_opening_customer_currency")
  @@index([customerId])
  @@index([openingDate])
  @@map("opening_customer_balances")
}

model OpeningStock {
  id          Int      @id @default(autoincrement())
  cityId      Int      @map("city_id")
  godownId    Int      @map("godown_id")
  productId   Int      @map("product_id")
  qty         Decimal  @db.Decimal(12, 2)
  openingDate DateTime @map("opening_date") @db.Date
  notes       String?  @db.Text
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  city    City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  godown  Godown  @relation(fields: [godownId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  creator User    @relation(fields: [createdBy], references: [id])

  @@unique([godownId, productId], name: "unique_opening_stock_godown_product")
  @@index([cityId])
  @@index([openingDate])
  @@map("opening_stocks")
}

model OpeningBankBalance {
  id            Int      @id @default(autoincrement())
  cityId        Int      @map("city_id")
  bankAccountId Int      @map("bank_account_id")
  currencyId    Int      @map("currency_id")
  amount        Decimal  @db.Decimal(15, 2)
  openingDate   DateTime @map("opening_date") @db.Date
  notes         String?  @db.Text
  createdBy     Int      @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  city        City        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  currency    Currency    @relation(fields: [currencyId], references: [id])
  creator     User        @relation(fields: [createdBy], references: [id])

  @@unique([bankAccountId, currencyId], name: "unique_opening_bank_account_currency")
  @@index([cityId])
  @@map("opening_bank_balances")
}

model OpeningCheque {
  id            Int       @id @default(autoincrement())
  cityId        Int       @map("city_id")
  currencyId    Int       @map("currency_id")
  amount        Decimal   @db.Decimal(15, 2)
  chequeNumber  String    @map("cheque_number") @db.VarChar(50)
  chequeBank    String?   @map("cheque_bank") @db.VarChar(100)
  chequeDueDate DateTime? @map("cheque_due_date") @db.Date
  openingDate   DateTime  @map("opening_date") @db.Date
  notes         String?   @db.Text
  createdBy     Int       @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  city     City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id])
  creator  User     @relation(fields: [createdBy], references: [id])

  @@index([cityId])
  @@map("opening_cheques")
}

// ============================================================
// LOTS
// ============================================================

model Lot {
  id          Int       @id @default(autoincrement())
  countryId   Int       @map("country_id")
  lotNumber   String    @map("lot_number") @db.VarChar(50)
  lotDate     DateTime  @map("lot_date") @db.Date
  notes           String?  @db.Text
  pkrExchangeRate Decimal? @map("pkr_exchange_rate") @db.Decimal(12, 4) // USD/PKR rate for profit calc
  status          LotStatus @default(ongoing)
  isLegacyStock   Boolean   @default(false) @map("is_legacy_stock")
  createdBy   Int       @map("created_by")
  completedBy Int?      @map("completed_by")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  country            Country              @relation(fields: [countryId], references: [id])
  creator            User                 @relation("LotCreatedBy", fields: [createdBy], references: [id])
  completer          User?                @relation("LotCompletedBy", fields: [completedBy], references: [id])
  lotProducts        LotProduct[]
  lotCityDistributions LotCityDistribution[]
  sales              Sale[]
  payments           Payment[]
  expenses           Expense[]
  hajiTransfers      HajiTransfer[]
  godownTransfers    GodownTransfer[]
  saleDiscounts      SaleDiscount[]
  paymentLotTransfersFrom PaymentLotTransfer[] @relation("TransferFromLot")
  paymentLotTransfersTo   PaymentLotTransfer[] @relation("TransferToLot")
  lotSettlementOverflowsFrom LotSettlementOverflow[] @relation("OverflowFromLot")
  lotSettlementOverflowsTo   LotSettlementOverflow[] @relation("OverflowToLot")
  lotPurchases               LotPurchase[]
  lotCosts                   LotCost[]
  supplierPayments           SupplierPayment[]
  shippingLinePayments       ShippingLinePayment[]
  cityTransfers              CityTransfer[]

  @@unique([countryId, lotNumber])
  @@index([countryId])
  @@index([status])
  @@index([lotDate])
  @@map("lots")
}

model LotProduct {
  id        Int      @id @default(autoincrement())
  lotId     Int      @map("lot_id")
  productId Int      @map("product_id")
  totalQty  Decimal  @map("total_qty") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lot     Lot     @relation(fields: [lotId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([lotId, productId])
  @@index([lotId])
  @@map("lot_products")
}

model LotCityDistribution {
  id           Int      @id @default(autoincrement())
  lotId        Int      @map("lot_id")
  cityId       Int      @map("city_id")
  productId    Int      @map("product_id")
  allocatedQty Decimal  @map("allocated_qty") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lot     Lot     @relation(fields: [lotId], references: [id])
  city    City    @relation(fields: [cityId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  godownAllocations LotCityGodownAllocation[]

  @@unique([lotId, cityId, productId])
  @@index([lotId])
  @@index([cityId])
  @@map("lot_city_distributions")
}

model LotCityGodownAllocation {
  id                      Int      @id @default(autoincrement())
  lotCityDistributionId   Int      @map("lot_city_distribution_id")
  godownId                Int      @map("godown_id")
  productId               Int      @map("product_id")
  qty                     Decimal  @db.Decimal(12, 2)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  lotCityDistribution LotCityDistribution @relation(fields: [lotCityDistributionId], references: [id])
  godown              Godown               @relation(fields: [godownId], references: [id])
  product             Product              @relation("ProductGodownAlloc", fields: [productId], references: [id])

  @@unique([lotCityDistributionId, godownId])
  @@index([lotCityDistributionId])
  @@index([godownId])
  @@map("lot_city_godown_allocations")
}

// ============================================================
// SALES
// ============================================================

model VoucherSequence {
  id            Int @id @default(autoincrement())
  cityId        Int @unique @map("city_id")
  currentNumber Int @default(0) @map("current_number")

  city City @relation(fields: [cityId], references: [id])

  @@map("voucher_sequences")
}

model Sale {
  id                Int        @id @default(autoincrement())
  cityId            Int        @map("city_id")
  customerId        Int        @map("customer_id")
  lotId             Int        @map("lot_id")
  godownId          Int        @map("godown_id")
  voucherNo         String     @map("voucher_no") @db.VarChar(10)
  saleDate          DateTime   @map("sale_date") @db.Date
  totalAmount       Decimal    @default(0) @map("total_amount") @db.Decimal(15, 2)
  currencyId        Int        @map("currency_id")
  notes             String?    @db.Text
  status            SaleStatus @default(active)
  isOpeningImport   Boolean    @default(false) @map("is_opening_import")
  stockShortFlag    Boolean    @default(false) @map("stock_short_flag")
  cancellationReason String?   @map("cancellation_reason") @db.Text
  cancelledAt       DateTime?  @map("cancelled_at")
  cancelledBy       Int?       @map("cancelled_by")
  createdBy         Int        @map("created_by")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  city       City     @relation(fields: [cityId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  lot        Lot      @relation(fields: [lotId], references: [id])
  godown     Godown   @relation(fields: [godownId], references: [id])
  currency   Currency @relation(fields: [currencyId], references: [id])
  creator    User     @relation("SaleCreatedBy", fields: [createdBy], references: [id])
  canceller  User?    @relation("SaleCancelledBy", fields: [cancelledBy], references: [id])

  items       SaleItem[]
  discounts   SaleDiscount[]
  attachments Attachment[]
  payments    Payment[]

  @@index([cityId])
  @@index([customerId])
  @@index([lotId])
  @@index([godownId])
  @@index([saleDate])
  @@index([status])
  @@index([cityId, voucherNo])
  @@index([cityId, saleDate])
  @@index([cityId, status, saleDate])
  @@map("sales")
}

model SaleItem {
  id            Int     @id @default(autoincrement())
  saleId        Int     @map("sale_id")
  productId     Int     @map("product_id")
  qty           Decimal @db.Decimal(12, 2)
  ratePerCarton Decimal @map("rate_per_carton") @db.Decimal(12, 2)
  amount        Decimal @db.Decimal(15, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SaleDiscount {
  id              Int      @id @default(autoincrement())
  saleId          Int      @map("sale_id")
  discountAmount  Decimal  @map("discount_amount") @db.Decimal(15, 2)
  currencyId      Int      @map("currency_id")
  appliedToLotId  Int      @map("applied_to_lot_id")
  notes           String?  @db.Text
  discountDate    DateTime @map("discount_date") @db.Date
  createdBy       Int      @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  sale          Sale     @relation(fields: [saleId], references: [id])
  currency      Currency @relation(fields: [currencyId], references: [id])
  appliedToLot  Lot      @relation(fields: [appliedToLotId], references: [id])
  creator       User     @relation(fields: [createdBy], references: [id])

  @@index([saleId])
  @@index([appliedToLotId])
  @@map("sale_discounts")
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id                 Int                @id @default(autoincrement())
  cityId             Int                @map("city_id")
  customerId         Int                @map("customer_id")
  lotId              Int                @map("lot_id")
  paymentDate        DateTime           @map("payment_date") @db.Date
  detail             String             @db.VarChar(500)
  amount             Decimal            @db.Decimal(15, 2)
  currencyId         Int                @map("currency_id")
  exchangeRate       Decimal?           @map("exchange_rate") @db.Decimal(12, 4)
  usdEquivalent      Decimal?           @map("usd_equivalent") @db.Decimal(15, 2)
  manualVoucherNo    String?            @map("manual_voucher_no") @db.VarChar(50)
  paymentMethod      PaymentMethod      @map("payment_method")
  destination        PaymentDestination
  notes              String?            @db.Text
  status             PaymentStatus      @default(active)
  cancellationReason String?            @map("cancellation_reason") @db.Text
  cancelledAt        DateTime?          @map("cancelled_at")
  cancelledBy        Int?               @map("cancelled_by")
  // Cheque-specific fields (populated when paymentMethod = cheque)
  chequeNumber       String?            @map("cheque_number") @db.VarChar(50)
  chequeBank         String?            @map("cheque_bank") @db.VarChar(100)
  chequeDueDate      DateTime?          @map("cheque_due_date") @db.Date
  chequeStatus       ChequeStatus?      @map("cheque_status")
  bankDepositId      Int?               @map("bank_deposit_id")
  bankAccountId      Int?               @map("bank_account_id")
  superAdminBankAccountId Int?          @map("super_admin_bank_account_id")
  saleId              Int?              @map("sale_id")
  createdBy          Int                @map("created_by")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  city        City        @relation(fields: [cityId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])
  lot         Lot         @relation(fields: [lotId], references: [id])
  currency    Currency    @relation(fields: [currencyId], references: [id])
  creator     User        @relation("PaymentCreatedBy", fields: [createdBy], references: [id])
  canceller   User?       @relation("PaymentCancelledBy", fields: [cancelledBy], references: [id])
  bankDeposit BankDeposit? @relation("DepositCheques", fields: [bankDepositId], references: [id])
  bankAccount BankAccount? @relation("PaymentBankAccount", fields: [bankAccountId], references: [id])
  superAdminBankAccount SuperAdminBankAccount? @relation("PaymentSuperAdminBankAccount", fields: [superAdminBankAccountId], references: [id])
  sale        Sale?        @relation(fields: [saleId], references: [id])

  attachments         Attachment[]
  paymentLotTransfers PaymentLotTransfer[]
  hajiTransferCheque  HajiTransfer?        @relation("HajiCheque")
  expenseCheques      Expense[]            @relation("ExpenseCheque")
  withdrawalCheques   PersonalWithdrawal[] @relation("WithdrawalCheque")

  @@index([cityId])
  @@index([customerId])
  @@index([lotId])
  @@index([paymentDate])
  @@index([status])
  @@index([paymentMethod])
  @@index([bankAccountId])
  @@index([superAdminBankAccountId])
  @@index([saleId])
  @@index([cityId, paymentDate])
  @@index([cityId, status, paymentDate])
  @@index([cityId, destination, paymentDate])
  @@index([cityId, manualVoucherNo])
  @@map("payments")
}

model PaymentLotTransfer {
  id            Int      @id @default(autoincrement())
  paymentId     Int      @map("payment_id")
  fromLotId     Int      @map("from_lot_id")
  toLotId       Int      @map("to_lot_id")
  transferredBy Int      @map("transferred_by")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  payment     Payment @relation(fields: [paymentId], references: [id])
  fromLot     Lot     @relation("TransferFromLot", fields: [fromLotId], references: [id])
  toLot       Lot     @relation("TransferToLot", fields: [toLotId], references: [id])
  transferrer User    @relation(fields: [transferredBy], references: [id])

  @@index([paymentId])
  @@index([fromLotId])
  @@index([toLotId])
  @@map("payment_lot_transfers")
}

// ============================================================
// EXPENSES
// ============================================================

model Expense {
  id          Int       @id @default(autoincrement())
  cityId      Int       @map("city_id")
  lotId       Int       @map("lot_id")
  expenseDate DateTime  @map("expense_date") @db.Date
  amount      Decimal   @db.Decimal(15, 2)
  currencyId  Int       @map("currency_id")
  detail      String    @db.VarChar(500)
  notes       String?   @db.Text
  // Treasury: which pot paid for this expense
  paidFrom      ExpensePaidFrom @default(cash_office) @map("paid_from")
  bankAccountId Int?            @map("bank_account_id")
  chequePaymentId Int?          @map("cheque_payment_id")
  createdBy   Int       @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at") // null = active; non-null = soft-deleted

  city        City         @relation(fields: [cityId], references: [id])
  lot         Lot          @relation(fields: [lotId], references: [id])
  currency    Currency     @relation(fields: [currencyId], references: [id])
  creator     User         @relation(fields: [createdBy], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  chequePayment Payment?   @relation("ExpenseCheque", fields: [chequePaymentId], references: [id])
  attachments Attachment[]

  @@index([cityId])
  @@index([lotId])
  @@index([expenseDate])
  @@index([deletedAt])
  @@map("expenses")
}

// ============================================================
// PERSONAL WITHDRAWALS
// ============================================================

model PersonalWithdrawal {
  id             Int       @id @default(autoincrement())
  cityId         Int       @map("city_id")
  withdrawalDate DateTime  @map("withdrawal_date") @db.Date
  amount         Decimal   @db.Decimal(15, 2)
  currencyId     Int       @map("currency_id")
  detail         String    @db.VarChar(500)
  withdrawnBy    String?   @map("withdrawn_by") @db.VarChar(100)
  notes          String?   @db.Text
  sourceType     WithdrawalSourceType @default(cash_office) @map("source_type")
  chequePaymentId Int?     @map("cheque_payment_id")
  approvedBy     Int?      @map("approved_by")
  approvedAt     DateTime? @map("approved_at")
  hajiTransferId Int?      @unique @map("haji_transfer_id")
  createdBy      Int       @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  city         City          @relation(fields: [cityId], references: [id])
  currency     Currency      @relation(fields: [currencyId], references: [id])
  creator      User          @relation("WithdrawalCreator", fields: [createdBy], references: [id])
  approver     User?         @relation("WithdrawalApprover", fields: [approvedBy], references: [id])
  hajiTransfer HajiTransfer? @relation(fields: [hajiTransferId], references: [id])
  chequePayment Payment?     @relation("WithdrawalCheque", fields: [chequePaymentId], references: [id])

  @@index([cityId])
  @@index([withdrawalDate])
  @@index([approvedBy])
  @@map("personal_withdrawals")
}

// ============================================================
// HAJI TRANSFERS
// ============================================================

model HajiTransfer {
  id           Int              @id @default(autoincrement())
  cityId       Int              @map("city_id")
  lotId        Int              @map("lot_id")
  transferDate DateTime         @map("transfer_date") @db.Date
  amount       Decimal          @db.Decimal(15, 2)
  currencyId   Int              @map("currency_id")
  detail        String           @db.VarChar(500)
  referenceNo   String?          @map("reference_no") @db.VarChar(50)
  transferType  HajiTransferType @map("transfer_type")
  transferredTo String?          @map("transferred_to") @db.VarChar(100)
  notes         String?          @db.Text
  // Treasury: where the money came from
  sourceType       HajiSourceType @default(cash_office) @map("source_type")
  settlementDestination HajiSettlementDestination @default(standard) @map("settlement_destination")
  intermediaryId        Int?                      @map("intermediary_id")
  superAdminCashAccountId Int?                    @map("super_admin_cash_account_id")
  superAdminBankAccountId Int?                    @map("super_admin_bank_account_id")
  bankAccountId    Int?           @map("bank_account_id")
  chequePaymentId  Int?           @unique @map("cheque_payment_id")
  createdBy     Int              @map("created_by")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  city          City         @relation(fields: [cityId], references: [id])
  lot           Lot          @relation(fields: [lotId], references: [id])
  currency      Currency     @relation(fields: [currencyId], references: [id])
  creator       User         @relation(fields: [createdBy], references: [id])
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  chequePayment Payment?     @relation("HajiCheque", fields: [chequePaymentId], references: [id])
  intermediary  Intermediary? @relation(fields: [intermediaryId], references: [id])
  superAdminCashAccount SuperAdminBankAccount? @relation("HajiSuperAdminCash", fields: [superAdminCashAccountId], references: [id])
  superAdminBankAccount SuperAdminBankAccount? @relation("HajiSuperAdminBank", fields: [superAdminBankAccountId], references: [id])

  withdrawalSource PersonalWithdrawal?
  attachments      Attachment[]

  @@index([cityId])
  @@index([lotId])
  @@index([transferDate])
  @@index([transferredTo])
  @@index([intermediaryId])
  @@index([superAdminCashAccountId])
  @@index([superAdminBankAccountId])
  @@map("haji_transfers")
}

model LotSettlementOverflow {
  id             Int      @id @default(autoincrement())
  cityId         Int      @map("city_id")
  fromLotId      Int      @map("from_lot_id")
  toLotId        Int      @map("to_lot_id")
  overflowAmount Decimal  @map("overflow_amount") @db.Decimal(15, 2)
  currencyId     Int      @map("currency_id")
  notes          String?  @db.Text
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  city     City     @relation(fields: [cityId], references: [id])
  fromLot  Lot      @relation("OverflowFromLot", fields: [fromLotId], references: [id])
  toLot    Lot      @relation("OverflowToLot", fields: [toLotId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])
  creator  User     @relation(fields: [createdBy], references: [id])

  @@index([cityId])
  @@index([fromLotId])
  @@index([toLotId])
  @@map("lot_settlement_overflows")
}

// ============================================================
// TREASURY - Bank Accounts & Deposit Slips
// ============================================================

model BankAccount {
  id            Int      @id @default(autoincrement())
  cityId        Int      @map("city_id")
  bankName      String   @map("bank_name") @db.VarChar(100)
  accountNumber String?  @map("account_number") @db.VarChar(50)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  city             City              @relation(fields: [cityId], references: [id])
  deposits              BankDeposit[]
  hajiTransfers         HajiTransfer[]
  expenses              Expense[]
  lotCosts              LotCost[]
  supplierPayments        SupplierPayment[]        @relation("SupplierPaymentBankAccount")
  shippingLinePayments    ShippingLinePayment[]    @relation("ShippingLinePaymentBankAccount")
  agentPayments           AgentPayment[]           @relation("AgentPaymentBankAccount")
  intermediaryDeposits    IntermediaryDeposit[]
  incomingPayments        Payment[]                @relation("PaymentBankAccount")
  openingBankBalances     OpeningBankBalance[]

  @@index([cityId])
  @@map("bank_accounts")
}

model BankDeposit {
  id            Int      @id @default(autoincrement())
  cityId        Int      @map("city_id")
  bankAccountId Int      @map("bank_account_id")
  depositDate   DateTime @map("deposit_date") @db.Date
  slipNumber    String?  @map("slip_number") @db.VarChar(50)
  cashAmount    Decimal  @default(0) @map("cash_amount") @db.Decimal(15, 2)
  currencyId    Int      @map("currency_id")
  notes         String?  @db.Text
  createdBy     Int      @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  city        City        @relation(fields: [cityId], references: [id])
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  currency    Currency    @relation(fields: [currencyId], references: [id])
  cheques     Payment[]   @relation("DepositCheques")

  @@index([cityId])
  @@index([bankAccountId])
  @@index([depositDate])
  @@map("bank_deposits")
}

model SuperAdminBankAccount {
  id            Int      @id @default(autoincrement())
  bankName      String   @map("bank_name") @db.VarChar(100)
  accountNumber String?  @map("account_number") @db.VarChar(50)
  currencyId    Int      @map("currency_id")
  accountKind   SuperAdminAccountKind @default(bank) @map("account_kind")
  isActive      Boolean  @default(true) @map("is_active")
  createdBy     Int      @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  currency Currency @relation(fields: [currencyId], references: [id])
  creator  User     @relation(fields: [createdBy], references: [id])
  expenses SuperAdminPersonalExpense[]
  lotCosts LotCost[]
  incomingHajiPayments Payment[] @relation("PaymentSuperAdminBankAccount")
  intermediaryDeposits IntermediaryDeposit[]
  intermediaryDepositsFromCash IntermediaryDeposit[] @relation("IntermediaryDepositSuperAdminCash")
  supplierPayments SupplierPayment[] @relation("SupplierPaymentSuperAdminBank")
  supplierPaymentsFromCash SupplierPayment[] @relation("SupplierPaymentSuperAdminCash")
  agentPaymentsFromCash AgentPayment[] @relation("AgentPaymentSuperAdminCash")
  shippingLinePaymentsFromCash ShippingLinePayment[] @relation("ShippingLinePaymentSuperAdminCash")
  hajiTransferReceipts HajiTransfer[] @relation("HajiSuperAdminCash")
  hajiTransferBankReceipts HajiTransfer[] @relation("HajiSuperAdminBank")
  hajiCashReceipts HajiCashReceipt[]

  @@index([currencyId])
  @@index([createdBy])
  @@map("super_admin_bank_accounts")
}

model SuperAdminPersonalExpense {
  id           Int       @id @default(autoincrement())
  bankAccountId Int      @map("bank_account_id")
  expenseDate  DateTime  @map("expense_date") @db.Date
  amount       Decimal   @db.Decimal(15, 2)
  detail       String    @db.VarChar(500)
  notes        String?   @db.Text
  createdBy    Int       @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  bankAccount SuperAdminBankAccount @relation(fields: [bankAccountId], references: [id])
  creator     User                  @relation(fields: [createdBy], references: [id])

  @@index([bankAccountId])
  @@index([expenseDate])
  @@index([deletedAt])
  @@map("super_admin_personal_expenses")
}

// ============================================================
// ACCOUNTING - Chart of Accounts & Journal Entries
// ============================================================

enum AccountType {
  asset
  liability
  revenue
  expense
  equity
  cogs
}

model Account {
  id          Int         @id @default(autoincrement())
  code        String      @unique @db.VarChar(20)
  name        String      @db.VarChar(200)
  accountType AccountType @map("account_type")
  parentId    Int?        @map("parent_id")
  cityId      Int?        @map("city_id") // null = global account
  currencyCode String?    @map("currency_code") @db.VarChar(10)
  isSystem    Boolean     @default(false) @map("is_system") // system-created, cannot delete
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")

  parent          Account?       @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        Account[]      @relation("AccountHierarchy")
  city            City?          @relation(fields: [cityId], references: [id])
  journalEntries  JournalEntry[]
  agents          Agent[]

  @@index([accountType])
  @@index([cityId])
  @@map("accounts")
}

model JournalEntry {
  id            Int      @id @default(autoincrement())
  transactionId String   @map("transaction_id") @db.VarChar(50) // groups related entries: "SALE-123", "PAY-456"
  accountId     Int      @map("account_id")
  debit         Decimal  @default(0) @db.Decimal(15, 2)
  credit        Decimal  @default(0) @db.Decimal(15, 2)
  currencyCode  String   @map("currency_code") @db.VarChar(10)
  exchangeRate  Decimal? @map("exchange_rate") @db.Decimal(12, 4)
  description   String   @db.VarChar(500)
  entityType    String?  @map("entity_type") @db.VarChar(50) // sale, payment, expense, etc
  entityId      Int?     @map("entity_id")
  lotId         Int?     @map("lot_id")
  cityId        Int?     @map("city_id")
  entryDate     DateTime @map("entry_date") @db.Date
  createdBy     Int      @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  account  Account @relation(fields: [accountId], references: [id])

  @@index([transactionId])
  @@index([accountId])
  @@index([entityType, entityId])
  @@index([lotId])
  @@index([cityId])
  @@index([entryDate])
  @@map("journal_entries")
}

// ============================================================
// AGENTS (Customs agents, transport, etc. - running accounts)
// ============================================================

model Agent {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  agentType String   @map("agent_type") @db.VarChar(50) // customs, transport, freight, other
  cityId    Int?     @map("city_id") // linked to a city/port
  phone     String?  @db.VarChar(50)
  notes     String?  @db.Text
  accountId Int?     @map("account_id") // linked to their payable account
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city          City?          @relation(fields: [cityId], references: [id])
  account       Account?       @relation(fields: [accountId], references: [id])
  agentPayments AgentPayment[]
  lotCosts      LotCost[]
  openingLiabilities OpeningLiability[]

  @@index([agentType])
  @@index([cityId])
  @@map("agents")
}

model AgentPayment {
  id            Int      @id @default(autoincrement())
  agentId       Int      @map("agent_id")
  cityId        Int      @map("city_id")
  paymentDate   DateTime @map("payment_date") @db.Date
  amount        Decimal  @db.Decimal(15, 2)
  currencyCode  String   @map("currency_code") @db.VarChar(10)
  paymentMethod String   @map("payment_method") @db.VarChar(50)
  bankAccountId  Int?    @map("bank_account_id")  // if paid from bank
  intermediaryId Int?    @map("intermediary_id")   // if paid through intermediary
  superAdminCashAccountId Int? @map("super_admin_cash_account_id")
  reference     String?  @db.VarChar(200)
  notes         String?  @db.Text
  createdBy     Int      @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  agent        Agent         @relation(fields: [agentId], references: [id])
  city         City          @relation(fields: [cityId], references: [id])
  bankAccount  BankAccount?  @relation("AgentPaymentBankAccount", fields: [bankAccountId], references: [id])
  intermediary Intermediary? @relation("AgentPaymentIntermediary", fields: [intermediaryId], references: [id])
  superAdminCashAccount SuperAdminBankAccount? @relation("AgentPaymentSuperAdminCash", fields: [superAdminCashAccountId], references: [id])
  creator      User          @relation("AgentPaymentCreatedBy", fields: [createdBy], references: [id])

  @@index([agentId])
  @@index([cityId])
  @@index([paymentDate])
  @@index([bankAccountId])
  @@index([intermediaryId])
  @@index([superAdminCashAccountId])
  @@map("agent_payments")
}

// ============================================================
// INTER-CITY TRANSFERS
// ============================================================

model CityTransfer {
  id              Int      @id @default(autoincrement())
  fromCityId      Int      @map("from_city_id")
  toCityId        Int      @map("to_city_id")
  fromGodownId    Int      @map("from_godown_id")
  toGodownId      Int?     @map("to_godown_id") // null until receiver approves
  productId       Int      @map("product_id")
  lotId           Int      @map("lot_id")
  qty             Decimal  @db.Decimal(12, 2)
  status          String   @default("pending") @db.VarChar(20) // pending, approved, rejected
  notes           String?  @db.Text
  approvalNotes   String?  @map("approval_notes") @db.Text
  sentBy          Int      @map("sent_by")
  approvedBy      Int?     @map("approved_by")
  transferDate    DateTime @map("transfer_date") @db.Date
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  fromCity    City    @relation("TransferFromCity", fields: [fromCityId], references: [id])
  toCity      City    @relation("TransferToCity", fields: [toCityId], references: [id])
  fromGodown  Godown  @relation("TransferFromGodown", fields: [fromGodownId], references: [id])
  toGodown    Godown? @relation("TransferToGodown", fields: [toGodownId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
  lot         Lot     @relation(fields: [lotId], references: [id])
  sender      User    @relation("TransferSentBy", fields: [sentBy], references: [id])
  approver    User?   @relation("TransferApprovedBy", fields: [approvedBy], references: [id])

  @@index([fromCityId])
  @@index([toCityId])
  @@index([status])
  @@map("city_transfers")
}

// ============================================================
// SUPPLIER (Company you buy from)
// ============================================================

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  country   String?  @db.VarChar(100)
  contact   String?  @db.VarChar(200)
  notes     String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lotPurchases     LotPurchase[]
  supplierPayments SupplierPayment[]
  lotCosts         LotCost[]
  openingLiabilities OpeningLiability[]

  @@map("suppliers")
}

// ============================================================
// LOT PURCHASE (What you bought per lot - purchase price in USD)
// ============================================================

model LotPurchase {
  id              Int      @id @default(autoincrement())
  lotId           Int      @map("lot_id")
  supplierId      Int      @map("supplier_id")
  productId       Int      @map("product_id")
  qty                Decimal  @db.Decimal(12, 3)           // quantity in MT (metric tons)
  weightPerCartonKg  Decimal? @map("weight_per_carton_kg") @db.Decimal(10, 3) // kg per carton e.g. 20
  unitPriceUsd       Decimal  @map("unit_price_usd") @db.Decimal(12, 4)       // USD per MT
  totalPriceUsd      Decimal  @map("total_price_usd") @db.Decimal(15, 2)      // qty × unitPriceUsd
  exchangeRate       Decimal? @map("exchange_rate") @db.Decimal(12, 4)        // kept for legacy; rate is on SupplierPayment
  notes              String?  @db.Text
  createdBy       Int      @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  lot      Lot      @relation(fields: [lotId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  creator  User     @relation("PurchaseCreatedBy", fields: [createdBy], references: [id])

  @@index([lotId])
  @@index([supplierId])
  @@map("lot_purchases")
}

// ============================================================
// LOT COSTS (All costs: customs, freight, transport, etc.)
// ============================================================

model LotCost {
  id           Int         @id @default(autoincrement())
  lotId        Int         @map("lot_id")
  costType     LotCostType @map("cost_type")
  description  String      @db.VarChar(500)
  amount       Decimal     @db.Decimal(15, 2)
  currencyCode String      @default("USD") @map("currency_code") @db.VarChar(10)
  exchangeRate Decimal?    @map("exchange_rate") @db.Decimal(12, 4)
  costDate     DateTime?   @map("cost_date") @db.Date
  supplierId     Int?        @map("supplier_id")      // liability charged to supplier
  agentId        Int?        @map("agent_id")         // customs / transport agent
  shippingLineId Int?        @map("shipping_line_id")  // for freight costs
  bankAccountId  Int?        @map("bank_account_id")   // for direct bank payment
  superAdminBankAccountId Int? @map("super_admin_bank_account_id") // super admin bank debit source
  intermediaryId Int?        @map("intermediary_id")   // for intermediary settlement
  paidFromCash   Boolean     @default(false) @map("paid_from_cash")
  notes        String?     @db.Text
  createdBy    Int         @map("created_by")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  lot          Lot          @relation(fields: [lotId], references: [id])
  supplier     Supplier?    @relation(fields: [supplierId], references: [id])
  agent        Agent?       @relation(fields: [agentId], references: [id])
  shippingLine ShippingLine? @relation(fields: [shippingLineId], references: [id])
  bankAccount  BankAccount?  @relation(fields: [bankAccountId], references: [id])
  superAdminBankAccount SuperAdminBankAccount? @relation(fields: [superAdminBankAccountId], references: [id])
  intermediary Intermediary? @relation(fields: [intermediaryId], references: [id])
  creator      User         @relation("CostCreatedBy", fields: [createdBy], references: [id])

  @@index([lotId])
  @@index([costType])
  @@index([supplierId])
  @@index([agentId])
  @@index([bankAccountId])
  @@index([superAdminBankAccountId])
  @@index([intermediaryId])
  @@map("lot_costs")
}

// ============================================================
// SUPPLIER PAYMENTS (Payments to company - running account)
// ============================================================

model SupplierPayment {
  id            Int                   @id @default(autoincrement())
  supplierId      Int                   @map("supplier_id")
  lotId           Int?                  @map("lot_id") // optional - link to specific lot
  bankAccountId   Int?                  @map("bank_account_id") // legacy city bank
  superAdminBankAccountId Int?          @map("super_admin_bank_account_id")
  superAdminCashAccountId Int?          @map("super_admin_cash_account_id")
  intermediaryId  Int?                  @map("intermediary_id") // paid through hawala intermediary
  paymentDate   DateTime              @map("payment_date") @db.Date
  amountUsd     Decimal               @map("amount_usd") @db.Decimal(15, 2)
  exchangeRate  Decimal?              @map("exchange_rate") @db.Decimal(12, 4) // USD rate at payment time
  amountLocal   Decimal?              @map("amount_local") @db.Decimal(15, 2)  // equivalent in local currency
  paymentMethod SupplierPaymentMethod @map("payment_method")
  reference     String?               @db.VarChar(200) // bank ref, TT ref, etc
  notes         String?               @db.Text
  createdBy     Int                   @map("created_by")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  lot           Lot?          @relation(fields: [lotId], references: [id])
  bankAccount   BankAccount?  @relation("SupplierPaymentBankAccount", fields: [bankAccountId], references: [id])
  superAdminBankAccount SuperAdminBankAccount? @relation("SupplierPaymentSuperAdminBank", fields: [superAdminBankAccountId], references: [id])
  superAdminCashAccount SuperAdminBankAccount? @relation("SupplierPaymentSuperAdminCash", fields: [superAdminCashAccountId], references: [id])
  intermediary  Intermediary? @relation(fields: [intermediaryId], references: [id])
  creator       User          @relation("SupplierPaymentCreatedBy", fields: [createdBy], references: [id])

  @@index([supplierId])
  @@index([lotId])
  @@index([bankAccountId])
  @@index([superAdminBankAccountId])
  @@index([superAdminCashAccountId])
  @@index([intermediaryId])
  @@index([paymentDate])
  @@map("supplier_payments")
}

// ============================================================
// SHIPPING LINE (Freight carrier — separate running USD account)
// ============================================================

model ShippingLine {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  contact   String?  @db.VarChar(200)
  notes     String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lotCosts LotCost[]
  payments ShippingLinePayment[]
  openingLiabilities OpeningLiability[]

  @@map("shipping_lines")
}

model ShippingLinePayment {
  id             Int      @id @default(autoincrement())
  shippingLineId Int      @map("shipping_line_id")
  lotId          Int?     @map("lot_id")
  bankAccountId  Int?     @map("bank_account_id") // which bank the payment was sent from
  paymentDate    DateTime @map("payment_date") @db.Date
  amountUsd      Decimal  @map("amount_usd") @db.Decimal(15, 2)
  exchangeRate   Decimal? @map("exchange_rate") @db.Decimal(12, 4)
  amountPkr      Decimal? @map("amount_pkr") @db.Decimal(15, 2)
  reference      String?  @db.VarChar(200)
  notes          String?  @db.Text
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  intermediaryId Int? @map("intermediary_id")  // paid through intermediary (alternative to bank)
  superAdminCashAccountId Int? @map("super_admin_cash_account_id")

  shippingLine ShippingLine @relation(fields: [shippingLineId], references: [id])
  lot          Lot?         @relation(fields: [lotId], references: [id])
  bankAccount  BankAccount? @relation("ShippingLinePaymentBankAccount", fields: [bankAccountId], references: [id])
  intermediary Intermediary? @relation("ShippingLinePaymentIntermediary", fields: [intermediaryId], references: [id])
  superAdminCashAccount SuperAdminBankAccount? @relation("ShippingLinePaymentSuperAdminCash", fields: [superAdminCashAccountId], references: [id])
  creator      User         @relation("ShippingLinePaymentCreatedBy", fields: [createdBy], references: [id])

  @@index([shippingLineId])
  @@index([lotId])
  @@index([bankAccountId])
  @@index([intermediaryId])
  @@index([superAdminCashAccountId])
  @@map("shipping_line_payments")
}

// ============================================================
// FILE ATTACHMENTS (Polymorphic)
// ============================================================

model Attachment {
  id         Int        @id @default(autoincrement())
  entityType EntityType @map("entity_type")
  entityId   Int        @map("entity_id")
  fileName   String     @map("file_name") @db.VarChar(500)
  filePath   String     @map("file_path") @db.VarChar(1000)
  fileType   String     @map("file_type") @db.VarChar(20)
  fileSize   Int        @map("file_size")
  uploadedBy Int        @map("uploaded_by")
  createdAt  DateTime   @default(now()) @map("created_at")

  uploader        User            @relation(fields: [uploadedBy], references: [id])
  // Polymorphic relations (optional, for direct navigation)
  sale            Sale?           @relation(fields: [saleEntityId], references: [id])
  saleEntityId    Int?            @map("sale_entity_id")
  payment         Payment?        @relation(fields: [paymentEntityId], references: [id])
  paymentEntityId Int?            @map("payment_entity_id")
  godownTransfer         GodownTransfer? @relation(fields: [godownTransferEntityId], references: [id])
  godownTransferEntityId Int?            @map("godown_transfer_entity_id")
  expense                Expense?        @relation(fields: [expenseEntityId], references: [id])
  expenseEntityId        Int?            @map("expense_entity_id")
  hajiTransfer           HajiTransfer?   @relation(fields: [hajiTransferEntityId], references: [id])
  hajiTransferEntityId   Int?            @map("haji_transfer_entity_id")

  @@index([entityType, entityId])
  @@map("attachments")
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id         Int         @id @default(autoincrement())
  userId     Int         @map("user_id")
  cityId     Int?        @map("city_id")
  entityType String      @map("entity_type") @db.VarChar(100)
  entityId   Int         @map("entity_id")
  action     AuditAction
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  ipAddress  String?     @map("ip_address") @db.VarChar(50)
  createdAt  DateTime    @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id])
  city City? @relation(fields: [cityId], references: [id])

  @@index([userId])
  @@index([cityId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SyncRequest {
  id         Int      @id @default(autoincrement())
  cityId     Int      @map("city_id")
  module     String   @db.VarChar(80)
  requestId  String   @map("request_id") @db.VarChar(120)
  deviceId   String?  @map("device_id") @db.VarChar(120)
  entityType String?  @map("entity_type") @db.VarChar(80)
  entityId   Int?     @map("entity_id")
  createdBy  Int?     @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([cityId, module, requestId], name: "unique_sync_request_per_city_module")
  @@index([cityId])
  @@index([createdAt])
  @@map("sync_requests")
}

// ============================================================
// INVENTORY THRESHOLDS
// ============================================================

model InventoryThreshold {
  id        Int      @id @default(autoincrement())
  cityId    Int      @map("city_id")
  productId Int      @map("product_id")
  minQty    Decimal  @map("min_qty") @db.Decimal(12, 2)
  createdBy Int      @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city    City    @relation(fields: [cityId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  creator User    @relation(fields: [createdBy], references: [id])

  @@unique([cityId, productId])
  @@map("inventory_thresholds")
}

// ============================================================
// INVESTOR ACCOUNTS
// ============================================================

enum InvestorProfitType {
  fixed_rate       // profit = capital × fixed_rate%
  profit_share     // profit = total_business_profit × share%
}

model Investor {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(200)
  relationship String?  @db.VarChar(100)
  phone        String?  @db.VarChar(50)
  notes        String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    Int      @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  creator      User               @relation(fields: [createdBy], references: [id])
  accounts     InvestorAccount[]

  @@map("investors")
}

model InvestorAccount {
  id               Int                @id @default(autoincrement())
  investorId       Int                @map("investor_id")
  currencyId       Int                @map("currency_id")
  profitType       InvestorProfitType @default(fixed_rate) @map("profit_type")
  fixedRatePercent Decimal?           @map("fixed_rate_percent") @db.Decimal(6, 3)  // e.g. 12.000 = 12%
  profitSharePercent Decimal?         @map("profit_share_percent") @db.Decimal(6, 3) // e.g. 5.000 = 5%
  startDate        DateTime           @map("start_date") @db.Date
  isActive         Boolean            @default(true) @map("is_active")
  createdBy        Int                @map("created_by")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  investor          Investor            @relation(fields: [investorId], references: [id])
  currency          Currency            @relation(fields: [currencyId], references: [id])
  creator           User                @relation(fields: [createdBy], references: [id])
  deposits          InvestorDeposit[]
  withdrawals       InvestorWithdrawal[]
  profitAllocations ProfitAllocation[]

  @@map("investor_accounts")
}

model InvestorDeposit {
  id          Int      @id @default(autoincrement())
  accountId   Int      @map("account_id")
  amount      Decimal  @db.Decimal(15, 2)
  depositDate DateTime @map("deposit_date") @db.Date
  notes       String?  @db.Text
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  account   InvestorAccount @relation(fields: [accountId], references: [id])
  creator   User            @relation(fields: [createdBy], references: [id])

  @@map("investor_deposits")
}

model InvestorWithdrawal {
  id             Int      @id @default(autoincrement())
  accountId      Int      @map("account_id")
  amount         Decimal  @db.Decimal(15, 2)
  withdrawalDate DateTime @map("withdrawal_date") @db.Date
  notes          String?  @db.Text
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  account   InvestorAccount @relation(fields: [accountId], references: [id])
  creator   User            @relation(fields: [createdBy], references: [id])

  @@map("investor_withdrawals")
}

// ============================================================
// HAWALA / INTERMEDIARY PARTY
// ============================================================

model Intermediary {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  notes     String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  deposits             IntermediaryDeposit[]
  exchanges            IntermediaryExchange[]
  lotCosts             LotCost[]
  supplierPayments     SupplierPayment[]
  shippingLinePayments ShippingLinePayment[] @relation("ShippingLinePaymentIntermediary")
  agentPayments        AgentPayment[]        @relation("AgentPaymentIntermediary")
  openingLiabilities   OpeningLiability[]
  hajiTransfers        HajiTransfer[]
  hajiCashReceipts     HajiCashReceipt[]

  @@map("intermediaries")
}

model IntermediaryDeposit {
  id             Int                    @id @default(autoincrement())
  intermediaryId Int                    @map("intermediary_id")
  depositDate    DateTime               @map("deposit_date") @db.Date
  amount         Decimal                @db.Decimal(15, 2)
  currencyId     Int                    @map("currency_id")
  sourceType     IntermediarySourceType @map("source_type")
  cityId         Int?                   @map("city_id")         // if city_cash
  bankAccountId  Int?                   @map("bank_account_id") // if bank_account
  superAdminBankAccountId Int?          @map("super_admin_bank_account_id") // if super_admin_bank_account
  superAdminCashAccountId Int?          @map("super_admin_cash_account_id") // if super_admin_cash
  notes          String?                @db.Text
  createdBy      Int                    @map("created_by")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  intermediary Intermediary @relation(fields: [intermediaryId], references: [id])
  currency     Currency     @relation(fields: [currencyId], references: [id])
  city         City?        @relation(fields: [cityId], references: [id])
  bankAccount  BankAccount? @relation(fields: [bankAccountId], references: [id])
  superAdminBankAccount SuperAdminBankAccount? @relation(fields: [superAdminBankAccountId], references: [id])
  superAdminCashAccount SuperAdminBankAccount? @relation("IntermediaryDepositSuperAdminCash", fields: [superAdminCashAccountId], references: [id])
  creator      User         @relation(fields: [createdBy], references: [id])

  @@index([intermediaryId])
  @@index([depositDate])
  @@index([superAdminBankAccountId])
  @@index([superAdminCashAccountId])
  @@map("intermediary_deposits")
}

model HajiCashReceipt {
  id                      Int      @id @default(autoincrement())
  superAdminCashAccountId Int      @map("super_admin_cash_account_id")
  intermediaryId          Int      @map("intermediary_id")
  receiptDate             DateTime @map("receipt_date") @db.Date
  amount                  Decimal  @db.Decimal(15, 2)
  currencyId              Int      @map("currency_id")
  notes                   String?  @db.Text
  createdBy               Int      @map("created_by")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  superAdminCashAccount SuperAdminBankAccount @relation(fields: [superAdminCashAccountId], references: [id])
  intermediary          Intermediary          @relation(fields: [intermediaryId], references: [id])
  currency              Currency              @relation(fields: [currencyId], references: [id])
  creator               User                  @relation(fields: [createdBy], references: [id])

  @@index([superAdminCashAccountId])
  @@index([intermediaryId])
  @@index([receiptDate])
  @@map("haji_cash_receipts")
}

model IntermediaryExchange {
  id             Int      @id @default(autoincrement())
  intermediaryId Int      @map("intermediary_id")
  exchangeDate   DateTime @map("exchange_date") @db.Date
  baseCurrencyId Int?     @map("base_currency_id")
  quoteCurrencyId Int?    @map("quote_currency_id")
  fromCurrencyId Int      @map("from_currency_id")
  fromAmount     Decimal  @map("from_amount") @db.Decimal(15, 2)
  toCurrencyId   Int      @map("to_currency_id")
  toAmount       Decimal  @map("to_amount") @db.Decimal(15, 2)
  exchangeRate   Decimal  @map("exchange_rate") @db.Decimal(18, 6)
  notes          String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      Int?      @map("deleted_by")
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  intermediary Intermediary @relation(fields: [intermediaryId], references: [id])
  baseCurrency Currency? @relation("IntermediaryExchangeBaseCurrency", fields: [baseCurrencyId], references: [id])
  quoteCurrency Currency? @relation("IntermediaryExchangeQuoteCurrency", fields: [quoteCurrencyId], references: [id])
  fromCurrency Currency @relation("IntermediaryExchangeFromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrency   Currency @relation("IntermediaryExchangeToCurrency", fields: [toCurrencyId], references: [id])
  creator      User     @relation("IntermediaryExchangeCreatedBy", fields: [createdBy], references: [id])
  deleter      User?    @relation("IntermediaryExchangeDeletedBy", fields: [deletedBy], references: [id])

  @@index([intermediaryId, isActive])
  @@index([exchangeDate])
  @@index([baseCurrencyId])
  @@index([quoteCurrencyId])
  @@index([fromCurrencyId])
  @@index([toCurrencyId])
  @@map("intermediary_exchanges")
}

model OpeningLiability {
  id                 Int                  @id @default(autoincrement())
  liabilityType      OpeningLiabilityType @map("liability_type")
  supplierId         Int?                 @map("supplier_id")
  shippingLineId     Int?                 @map("shipping_line_id")
  agentId            Int?                 @map("agent_id")
  intermediaryId     Int?                 @map("intermediary_id")
  currencyId         Int                  @map("currency_id")
  amount             Decimal              @db.Decimal(15, 2)
  openingDate        DateTime             @map("opening_date") @db.Date
  notes              String?              @db.Text
  createdBy          Int                  @map("created_by")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  supplier           Supplier?            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  shippingLine       ShippingLine?        @relation(fields: [shippingLineId], references: [id], onDelete: Cascade)
  agent              Agent?               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  intermediary       Intermediary?        @relation(fields: [intermediaryId], references: [id], onDelete: Cascade)
  currency           Currency             @relation(fields: [currencyId], references: [id])
  creator            User                 @relation(fields: [createdBy], references: [id])

  @@unique([supplierId, currencyId], name: "unique_opening_liability_supplier_currency")
  @@unique([shippingLineId, currencyId], name: "unique_opening_liability_shipping_line_currency")
  @@unique([agentId, currencyId], name: "unique_opening_liability_agent_currency")
  @@unique([intermediaryId, currencyId], name: "unique_opening_liability_intermediary_currency")
  @@index([liabilityType])
  @@index([openingDate])
  @@map("opening_liabilities")
}

model ProfitAllocation {
  id             Int      @id @default(autoincrement())
  accountId      Int      @map("account_id")
  amount         Decimal  @db.Decimal(15, 2)
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  allocationDate DateTime @map("allocation_date") @db.Date
  notes          String?  @db.Text
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  account   InvestorAccount @relation(fields: [accountId], references: [id])
  creator   User            @relation(fields: [createdBy], references: [id])

  @@map("profit_allocations")
}
