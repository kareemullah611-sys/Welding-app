# Database (PostgreSQL) — LOCAL DEV ONLY
# Keep both URLs pointing at your local Postgres. Do not use Neon URLs here.
# setup.sh / setup-offline.sh set these automatically on macOS when possible.
DATABASE_URL="postgresql://user:password@localhost:5432/welding_app?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/welding_app?schema=public"
#
# Production (Render only — set in Render dashboard, NOT in this file):
# Fresh Neon database — do not copy Render Postgres data into Neon.
# DATABASE_URL = Neon pooled connection (*-pooler host, or ?pgbouncer=true)
# DIRECT_URL   = Neon direct connection (no pooler; required for prisma migrate deploy)
# Render build runs migrate once; start skips migrate when PRISMA_MIGRATE_AT_BUILD=true

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRY="24h"

# Required in production for AES-256-GCM encryption of sensitive financial PII
DATA_ENCRYPTION_KEY="replace-with-at-least-32-random-characters"

# Seeded user passwords (required by `npm run db:seed`)
ADMIN_PASSWORD="replace-with-a-strong-super-admin-password"
CITY_ADMIN_PASSWORD="replace-with-a-strong-city-admin-password"

# Production recommended — shared rate limits across multiple app instances (login brute-force protection)
# REDIS_URL="redis://localhost:6379"
# Production escape hatch only if Redis is temporarily unavailable.
ALLOW_MEMORY_RATE_LIMIT_IN_PRODUCTION="false"

# Experimental RLS transaction context. Keep false until policies are enabled and verified table-by-table.
ENABLE_PRISMA_RLS_CONTEXT="false"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production CSP violation reporting endpoint
CSP_REPORT_URI="/api/csp-report"
# Legacy proxy-only CSRF fallback. Keep false unless the reverse proxy is explicitly trusted.
TRUST_HOST_HEADER_CSRF="false"
# Required in production — used for CSRF origin checks on cookie-authenticated API calls
# Production example: https://welding-app-jhhc.onrender.com
# Offline snapshots, sync queue, and packaged offline mode (default off until go-live)
# When enabled, business data and an offline login verifier are stored in browser localStorage
# (unencrypted). Use only on trusted devices with full-disk encryption.
NEXT_PUBLIC_OFFLINE_ENABLED="false"
# Set to "true" after go-live to block city-admin opening edits (super_admin can still edit)
OPENINGS_LOCKED="false"
# Production (Render): https://welding-app-jhhc.onrender.com

# Sarafi.af assisted evidence capture. Current, complete Sarai Shahzada captures
# are automatically authorized after strict server-side validation.
SARAFI_AF_ASSISTED_CAPTURE_ENABLED="false"
SARAFI_AF_CAPTURE_TOKEN="replace-with-at-least-32-random-characters"
# GitHub Actions secret, not required by the application runtime:
# SARAFI_AF_CAPTURE_ENDPOINT="https://your-app.example/api/v1/fx-snapshots/sarafi-af/captures"
# Enables the legacy authenticated snapshot endpoint; scheduled assisted captures
# authorize through their service-token endpoint after strict validation.
SARAFI_AF_AUTO_SNAPSHOT_ENABLED="false"

# Daily official SBP USD/PKR capture and seven-day FX evidence cleanup.
# Use the same 32+ character value in Railway and GitHub Actions secrets.
DAILY_FX_CAPTURE_TOKEN="replace-with-at-least-32-random-characters"
# SBP_FX_CAPTURE_ENDPOINT="https://your-app.example/api/v1/fx-snapshots/sbp"
# FX_EVIDENCE_CLEANUP_ENDPOINT="https://your-app.example/api/v1/fx-snapshots/evidence-retention"

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# DeepSeek AI (assistant chatbot — disabled in production unless explicitly enabled)
DEEPSEEK_API_KEY=""
# ASSISTANT_ENABLED="true"
# Explicitly opt in only after confirming DeepSeek usage caps/key scope.
# ASSISTANT_ALLOW_EXTERNAL_FINANCIAL_DATA="true"

# Capacitor mobile deployments must use HTTPS unless this local-dev override is explicit.
# CAPACITOR_SERVER_URL="https://example.com"
# CAPACITOR_ALLOW_CLEARTEXT_HTTP="false"

# Dev-only destructive admin tools (blocked entirely when NODE_ENV=production)
# POST /api/v1/admin-cleanup with JSON body: { "secret": "..." }
# ENABLE_ADMIN_CLEANUP="true"
# ADMIN_CLEANUP_SECRET=""
