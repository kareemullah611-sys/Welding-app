# Database (PostgreSQL) — LOCAL DEV ONLY
# Keep both URLs pointing at your local Postgres. Do not use Neon URLs here.
# setup.sh / setup-offline.sh set these automatically on macOS when possible.
DATABASE_URL="postgresql://user:password@localhost:5432/welding_app?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/welding_app?schema=public"
#
# Production (Render only — set in Render dashboard, NOT in this file):
# Fresh Neon database — do not copy Render Postgres data into Neon.
# DATABASE_URL = Neon pooled connection (*-pooler host, or ?pgbouncer=true)
# DIRECT_URL   = Neon direct connection (no pooler; required for prisma migrate deploy)
# Render build runs migrate once; start skips migrate when PRISMA_MIGRATE_AT_BUILD=true

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRY="24h"

# Seeded user passwords (required by `npm run db:seed`)
ADMIN_PASSWORD="replace-with-a-strong-super-admin-password"
CITY_ADMIN_PASSWORD="replace-with-a-strong-city-admin-password"

# Optional — shared rate limits across multiple app instances (login brute-force protection)
# REDIS_URL="redis://localhost:6379"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Required in production — used for CSRF origin checks on cookie-authenticated API calls
# Production example: https://welding-app-jhhc.onrender.com
# Offline snapshots, sync queue, and packaged offline mode (default off until go-live)
# When enabled, business data and an offline login verifier are stored in browser localStorage
# (unencrypted). Use only on trusted devices with full-disk encryption.
NEXT_PUBLIC_OFFLINE_ENABLED="false"
# Set to "true" after go-live to block city-admin opening edits (super_admin can still edit)
OPENINGS_LOCKED="false"
# Production (Render): https://welding-app-jhhc.onrender.com

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# DeepSeek AI (assistant chatbot — disabled in production unless explicitly enabled)
DEEPSEEK_API_KEY=""
# ASSISTANT_ENABLED="true"

# Dev-only destructive admin tools (blocked entirely when NODE_ENV=production)
# POST /api/v1/admin-cleanup with JSON body: { "secret": "...", "action": "wipe" | "migrate" }
# ENABLE_ADMIN_CLEANUP="true"
# ADMIN_CLEANUP_SECRET=""
