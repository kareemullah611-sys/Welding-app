# Database
DATABASE_URL="postgresql://user:password@localhost:5432/welding_app?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRY="24h"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Offline snapshots, sync queue, and packaged offline mode (default off until go-live)
NEXT_PUBLIC_OFFLINE_ENABLED="false"
# Set to "true" after go-live to block city-admin opening edits (super_admin can still edit)
OPENINGS_LOCKED="false"
# Production (Render): https://welding-app-jhhc.onrender.com

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# DeepSeek AI (assistant chatbot)
DEEPSEEK_API_KEY=""
